---
import { site } from "@/lib/site";
import { getI18n } from "@/core/i18n";
const { t } = getI18n(Astro.url.pathname);
// Every theme shows the same copyright holder, links this site's source and keeps the upstream credit.
---
<span>© {new Date().getFullYear()} {site.owner}</span>
<a href={site.repository} target="_blank" rel="noopener noreferrer">{t("footer.source")} ↗</a>
<a href="https://github.com/Yuimi-chaya/Yuimi-chaya.github.io" target="_blank" rel="noopener noreferrer">{t("footer.themeCredit")} ↗</a>
