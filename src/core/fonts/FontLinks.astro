---
import { getFontSources, type FontFamily } from "./sources";

// Blank, Endfield and Arknights defer their fallback stylesheets until the browser is idle.
interface Props { families: FontFamily[]; locale: string }
const { families, locale } = Astro.props;
const { preload, pieces } = getFontSources(families, locale);
---
{preload.map((name) => <link rel="preload" href={`/fonts/site/${name}.woff2`} as="font" type="font/woff2" crossorigin />)}
{pieces.map((href) => <meta name="site-font-pieces" content={href} data-site-font-pieces />)}
<script is:inline>
  (() => {
    if (window.__siteFontPiecesReady) return;
    window.__siteFontPiecesReady = true;
    const apply = () => {
      for (const meta of document.querySelectorAll("meta[data-site-font-pieces]")) {
        const href = meta.getAttribute("content");
        if (!href) continue;
        if ([...document.head.querySelectorAll('link[rel="stylesheet"][data-site-font-loaded]')].some((l) => l.dataset.siteFontLoaded === href)) continue;
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = href;
        link.dataset.siteFontLoaded = href;
        document.head.append(link);
      }
    };
    const later = () => ("requestIdleCallback" in window ? requestIdleCallback(apply, { timeout: 3000 }) : setTimeout(apply, 1500));
    if (document.readyState === "complete") later(); else addEventListener("load", later, { once: true });
    // In-site navigation swaps the head without a new load event.
    document.addEventListener("astro:page-load", later);
  })();
</script>
