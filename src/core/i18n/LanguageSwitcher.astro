---
import { Icon } from "astro-icon/components";
import { getI18n, localizePath, localeNames, localeCodes, locales, type Locale } from "./index";
const { locale, t } = getI18n(Astro.url.pathname);
// Preserve the theme root even on its 404 page. localizePath handles Blank's
// special root 404.html route without changing named-theme routes.
const path = Astro.url.pathname;
---
<details class="site-language-menu" data-site-language-menu>
  <summary aria-label={t("a11y.language")} title={t("a11y.language")}>
    <Icon name="tabler:language" size={18} />
    <span>{localeCodes[locale]}</span>
    <Icon name="tabler:chevron-down" size={12} />
  </summary>
  <nav class="site-language-options" aria-label={t("a11y.language")}>
    {locales.map((language: Locale) => (
      <a href={localizePath(path, language)} lang={language} hreflang={language} data-site-locale={language} aria-current={locale === language ? "true" : undefined}>
        <span>{localeNames[language]}</span><span aria-hidden="true">{locale === language ? "✓" : ""}</span>
      </a>
    ))}
  </nav>
</details>
