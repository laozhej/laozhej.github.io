---
import { ClientRouter } from "astro:transitions";
// Shared by all routes in a Pages deployment; local previews use their own key.
const build = process.env.GITHUB_SHA || "local-preview";
---
<meta name="site-build" content={build} />
<ClientRouter fallback="animate" />
<script>
  import { installNavigationLifecycle } from "./lifecycle.mjs";
  import { mountLanguagePreference } from "../i18n/preference.mjs";
  import { mountThemePreference } from "../themes/preference.mjs";
  import { mountMotionPreference } from "../preferences/motion.mjs";
  import { mountSiteFeatures } from "../features/runtime.mjs";
  import { mountThemeRuntime } from "../themes/runtime.mjs";

  installNavigationLifecycle(document, window, () => {
    const cleanups = [
      mountMotionPreference(document, window),
      mountLanguagePreference(document, window),
      mountThemePreference(document, window),
      mountSiteFeatures(document, window),
      // Theme-specific enhancements come from registerThemeRuntime() in each layout.
      mountThemeRuntime(document, window),
    ];
    return () => cleanups.reverse().forEach((cleanup) => cleanup?.());
  });
</script>
<style is:global>
  @keyframes site-page-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes site-page-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  ::view-transition-group(site-header) { z-index: 2; }
  ::view-transition-group(site-content) { z-index: 1; }
  html[data-motion-paused="true"]::view-transition-group(*),
  html[data-motion-paused="true"]::view-transition-old(*),
  html[data-motion-paused="true"]::view-transition-new(*) { animation: none !important; }
  html[data-motion-paused="true"][data-astro-transition-fallback] main { animation: none !important; }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
    [data-astro-transition-fallback] main { animation: none !important; }
  }
</style>
