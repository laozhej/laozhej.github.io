---
import { Icon } from "astro-icon/components";
import { getI18n } from "@/core/i18n";
import { getTheme, getThemePath, themes } from "./registry";
// `floating` renders an icon-only button for a theme to pin in a corner; the list opens above it.
const { floating = false } = Astro.props;
const { locale, t } = getI18n(Astro.url.pathname);
const current = getTheme(Astro.url.pathname);
const path = `${Astro.url.pathname}${Astro.url.search}`;
---
<details class:list={["site-theme-menu", { "site-theme-dock": floating }]} data-site-theme-menu data-site-theme-path={Astro.url.pathname}>
  <summary aria-label={t("theme.switch")} title={t("theme.switch")}>
    <Icon name="tabler:palette" size={floating ? 20 : 18} aria-hidden="true" />
    {!floating && <span>{t(themes.find(({ id }) => id === current)!.labelKey)}</span>}
    {!floating && <Icon name="tabler:chevron-down" size={12} aria-hidden="true" />}
  </summary>
  <nav class="site-theme-options" aria-label={t("theme.switch")}>
    {floating && <p class="site-theme-title" aria-hidden="true">{t("theme.switch")}</p>}
    {themes.map((theme, index) => (
      <a href={getThemePath(theme.id, path, locale)} data-site-theme-target={theme.id} aria-current={current === theme.id ? "true" : undefined} style={`--i:${index}`}>
        {floating && <span class="site-theme-no" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
        <span>{t(theme.labelKey)}</span><span aria-hidden="true">{current === theme.id ? "✓" : ""}</span>
      </a>
    ))}
  </nav>
</details>
<style>
  .site-theme-menu { position: relative; font: inherit; }
  summary { display: flex; align-items: center; gap: .35rem; cursor: pointer; list-style: none; padding: .45rem .55rem; border-radius: .45rem; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
  summary:focus-visible, a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .site-theme-options { position: absolute; z-index: 100; inset-inline-end: 0; top: calc(100% + .5rem); min-width: 10rem; padding: .35rem; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: .6rem; background: var(--site-menu-background, #fff); color: var(--site-menu-color, #20232d); box-shadow: 0 8px 24px #0002; }
  a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem .7rem; border-radius: .3rem; color: inherit; text-decoration: none; white-space: nowrap; }
  a:hover, a[aria-current="true"] { background: color-mix(in srgb, currentColor 7%, transparent); }
  :global(html[data-color-mode="dark"]) .site-theme-options { background: var(--site-menu-background, #202027); color: var(--site-menu-color, #f4f2f3); }
  /* Floating dock: a fixed corner button whose list opens upward. Themes style and animate it. */
  .site-theme-dock { position: fixed; z-index: 45; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); }
  .site-theme-dock summary { justify-content: center; width: 48px; height: 48px; padding: 0; }
  .site-theme-dock .site-theme-options { top: auto; bottom: calc(100% + .75rem); min-width: 13rem; }
  .site-theme-dock a { justify-content: flex-start; }
  .site-theme-dock a > span:last-child { margin-inline-start: auto; }
  .site-theme-title { margin: 0; padding: .45rem .7rem .35rem; font-size: .75rem; opacity: .7; }
  .site-theme-no { font-variant-numeric: tabular-nums; opacity: .6; }
</style>
