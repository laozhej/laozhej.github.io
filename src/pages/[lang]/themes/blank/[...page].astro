---
import { render } from "astro:content";
import { getThemeStaticPaths } from "@/core/themes/static-paths";
import BlankLayout from "@/themes/blank/layouts/BlankLayout.astro";
import HomePage from "@/themes/blank/pages/HomePage.astro";
import BlogIndexPage from "@/themes/blank/pages/BlogIndexPage.astro";
import ArticlePage from "@/themes/blank/pages/ArticlePage.astro";
import ProjectsPage from "@/themes/blank/pages/ProjectsPage.astro";
import CollectionPage from "@/themes/blank/pages/CollectionPage.astro";
import AboutPage from "@/themes/blank/pages/AboutPage.astro";
import CreditsPage from "@/themes/blank/pages/CreditsPage.astro";
import NotFoundPage from "@/themes/blank/pages/NotFoundPage.astro";
import MovedPage from "@/core/components/MovedPage.astro";

export const getStaticPaths = () => getThemeStaticPaths(["zh-TW", "ja", "en"]);
const { kind, post, shelf, to } = Astro.props;
const pages = { home: HomePage, blog: BlogIndexPage, projects: ProjectsPage, collection: CollectionPage, about: AboutPage, credits: CreditsPage, "404": NotFoundPage, moved: MovedPage };
const Page = pages[kind as keyof typeof pages];
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
---
{Content ? <ArticlePage layout={BlankLayout} frontmatter={post.data} headings={rendered.headings} body={post.body}><Content /></ArticlePage> : <Page layout={BlankLayout} shelf={shelf} to={to} />}
