---
import { render } from "astro:content";
import { getPublishedPostPaths } from "@/core/content/blog";
import ArticlePage from "@/themes/arknights/pages/ArticlePage.astro";
export const getStaticPaths = getPublishedPostPaths;
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<ArticlePage frontmatter={post.data} headings={headings} body={post.body}><Content /></ArticlePage>
