---
// Arknights homepage: one running screen in five numbered sectors. The first is a typographic title block beside the
// latest entry, shown as its serial number on a dot-matrix board; then the log of entries, the tools in practice,
// the favourite games and the current status. Everything shown comes from the shared sources.
import { Icon } from "astro-icon/components";
import { getSiteContent } from "@/core/i18n/content";
import { getPublishedPosts } from "@/core/content/blog";
import { getThemedI18n as getI18n } from "@/core/themes/i18n";
import PageLayout from "@/core/themes/PageLayout.astro";
import { keepTails } from "@/core/i18n/wrap.mjs";
import { dotMatrix } from "../lib/matrix.mjs";
import { homeSectors, pad } from "../lib/sections.mjs";
const { locale, t, unit, href, categoryLabel, formatDate } = getI18n(Astro.url.pathname);
const { profileTech, currentSignals, projectEntries, favoriteGames, gameShelf } = getSiteContent(locale);
const posts = await getPublishedPosts(locale);
const [latest] = posts;
// Entries are numbered oldest first, so a number never changes once given.
const serial = (index: number) => pad(posts.length - index, 3);
const brand = t("ema.brand");
const [brandHead, ...brandTail] = brand.split(" ");
// The title drops the possessive visually; screen readers still hear the full name.
const brandName = brandHead.replace(/[’']s$/i, "");
const possessive = brandHead.slice(brandName.length);
const role = brandTail.join(" ");
// Chinese and Japanese sentences join directly; English needs a space.
const join = (...parts: string[]) => parts.join(locale === "en" ? " " : "");
const entryDate = (post: (typeof posts)[number]) => post.data.updatedDate ?? post.data.pubDate;
// Dates read as a log stamp (2026 // 11 / 15); screen readers get the usual local date instead.
const stamp = (date: Date) => {
  const [year, month, day] = date.toISOString().slice(0, 10).split("-");
  return `${year} // ${month} / ${day}`;
};
const host = Astro.site?.host ?? "";
// The latest entry's serial on the board; with nothing published the board reads zero.
const board = dotMatrix(latest ? serial(0) : "000");
// Sectors present on this page, numbered in order; the rail counts through them.
const present = new Set(["ak-index", "ak-records", "ak-practice", ...(favoriteGames.length ? ["ak-play"] : []), ...(currentSignals.length ? ["ak-status"] : [])]);
const sectors = homeSectors.filter(({ id }) => present.has(id)).map((sector, index) => ({ ...sector, number: pad(index) }));
const sector = Object.fromEntries(sectors.map((entry) => [entry.id, entry]));
const games = favoriteGames.map((item) => ({ ...item, art: gameShelf.find((game) => game.key === item.key)?.art }));
---
<PageLayout title={`${brand} | ${t("home.title")}`} description={t("arknights.description")} home>
  <section class="ak-hero ak-sector" id="ak-index" aria-labelledby="ak-home-title" data-ak-sector={sector["ak-index"].number} data-ak-word={sector["ak-index"].word} data-ak-enter>
    <span class="ak-lattice" aria-hidden="true"></span>
    <span class="ak-ghost ak-ghost--hero" data-ghost={role} aria-hidden="true"></span>
    <div class="ak-hero-copy">
      <p class="ak-annot" aria-hidden="true"><span>// {sector["ak-index"].number} {sector["ak-index"].word}</span>{latest && <span>Update {stamp(entryDate(latest))}</span>}{host && <span>{host}</span>}</p>
      <h1 id="ak-home-title" class="ak-title"><span class="ak-title-name">{brandName}<span class="ak-sr">{possessive}</span></span> <span class="ak-title-plate"><span>{role}</span></span></h1>
      <p class="ak-statement">{t("home.statement1")}<br />{t("home.statement2")}</p>
      <p class="ak-intro">{keepTails(join(t("home.intro1"), t("home.intro2")))}</p>
      <p class="ak-cta">
        {latest && <a class="ak-button ak-button--signal" href={href(`/blog/${latest.slug}/`)}><span>{t("home.latestLink")}</span><Icon name="tabler:chevron-right" size={18} aria-hidden="true" /></a>}
        <a class="ak-button" href={href("/about/")}><span>{t("common.about")}</span><Icon name="tabler:chevron-right" size={18} aria-hidden="true" /></a>
      </p>
    </div>
    {latest ? (
      <a class="ak-record" href={href(`/blog/${latest.slug}/`)}>
        <span class="ak-record-head" aria-hidden="true"><span>Latest record</span><span>No.{serial(0)}</span></span>
        <svg class="ak-matrix" viewBox={`-0.5 -0.5 ${board.width + 1} ${board.height + 1}`} aria-hidden="true" focusable="false">
          {board.rows.map((row) => (
            <g style={`--r:${row.y}`}>
              {row.off.map((x) => <rect class="ak-dot-off" x={x + 0.1} y={row.y + 0.1} width="0.8" height="0.8" />)}
              {row.on.map((x) => <rect class="ak-dot" x={x + 0.1} y={row.y + 0.1} width="0.8" height="0.8" />)}
            </g>
          ))}
        </svg>
        <span class="ak-record-meta"><span>{categoryLabel[latest.data.category]}</span><time datetime={entryDate(latest).toISOString()}><span aria-hidden="true">{stamp(entryDate(latest))}</span><span class="ak-sr">{formatDate(entryDate(latest))}</span></time></span>
        <strong class="ak-record-title" lang={latest.data.locale}>{keepTails(latest.data.title)}</strong>
        <span class="ak-record-plate"><span>{t("arknights.latest")}</span><Icon name="tabler:chevron-right" size={18} aria-hidden="true" /></span>
      </a>
    ) : (
      <div class="ak-record ak-record--empty">
        <span class="ak-record-head" aria-hidden="true"><span>Latest record</span><span>No.000</span></span>
        <svg class="ak-matrix" viewBox={`-0.5 -0.5 ${board.width + 1} ${board.height + 1}`} aria-hidden="true" focusable="false">
          {board.rows.map((row) => (
            <g style={`--r:${row.y}`}>
              {row.off.map((x) => <rect class="ak-dot-off" x={x + 0.1} y={row.y + 0.1} width="0.8" height="0.8" />)}
              {row.on.map((x) => <rect class="ak-dot" x={x + 0.1} y={row.y + 0.1} width="0.8" height="0.8" />)}
            </g>
          ))}
        </svg>
        <p class="ak-record-title">{t("home.empty")}</p>
      </div>
    )}
    <nav class="ak-index" aria-label={t("arknights.index")}>
      <a href={href("/blog/")}><small>{t("home.writingIndex")}</small><span><b>{pad(posts.length)}</b> {unit("common.entries", posts.length)}</span></a>
      <a href={href("/projects/")}><small>{t("home.practiceIndex")}</small><span><b>{pad(projectEntries.length)}</b> {unit("common.projects", projectEntries.length)}</span></a>
      <a href={href("/games/")}><small>{t("home.playIndex")}</small><span><b>{pad(favoriteGames.length)}</b> {unit("arknights.games", favoriteGames.length)}<i>{t("ema.about.gamesAll").replace("{n}", String(gameShelf.length))}</i></span></a>
    </nav>
  </section>

  <section class="ak-sector" id="ak-records" aria-labelledby="ak-records-title" data-ak-sector={sector["ak-records"].number} data-ak-word={sector["ak-records"].word}>
    <header class="ak-head">
      <span class="ak-head-no" aria-hidden="true">{sector["ak-records"].number}</span>
      <div><p class="ak-eyebrow" lang="en">// {sector["ak-records"].word}</p><h2 id="ak-records-title">{t("home.latest")}</h2></div>
      {posts.length > 0 && <a class="ak-link" href={href("/blog/")}>{t("common.allArticles")}<Icon name="tabler:chevron-right" size={16} aria-hidden="true" /></a>}
    </header>
    {posts.length > 0 ? (
      <ol class="ak-log">
        {posts.slice(0, 5).map((post, index) => (
          <li><a href={href(`/blog/${post.slug}/`)}>
            <span class="ak-log-kind">{categoryLabel[post.data.category]}</span>
            <time datetime={entryDate(post).toISOString()}><span aria-hidden="true">{stamp(entryDate(post))}</span><span class="ak-sr">{formatDate(entryDate(post))}</span></time>
            <span class="ak-log-title" lang={post.data.locale}>{keepTails(post.data.title)}</span>
            <span class="ak-log-text" lang={post.data.locale}>{post.data.description}</span>
            <span class="ak-log-no" aria-hidden="true">No.{serial(index)}</span>
          </a></li>
        ))}
      </ol>
    ) : <p class="ak-empty">{t("blog.empty")}</p>}
    <span class="ak-ghost" data-ghost={sector["ak-records"].word} aria-hidden="true"></span>
  </section>

  <section class="ak-sector" id="ak-practice" aria-labelledby="ak-practice-title" data-ak-sector={sector["ak-practice"].number} data-ak-word={sector["ak-practice"].word}>
    <header class="ak-head">
      <span class="ak-head-no" aria-hidden="true">{sector["ak-practice"].number}</span>
      <div><p class="ak-eyebrow" lang="en">// {sector["ak-practice"].word}</p><h2 id="ak-practice-title">{t("home.inProgress")}</h2></div>
      <a class="ak-link" href={href("/projects/")}>{t("common.projectNotes")}<Icon name="tabler:chevron-right" size={16} aria-hidden="true" /></a>
    </header>
    <p class="ak-lede">{join(t("home.practice1"), t("home.practice2"))}</p>
    <ol class="ak-terms">
      {profileTech.map((item, index) => <li><span class="ak-terms-no" aria-hidden="true">{pad(index + 1)}</span><strong>{item.name}</strong><span>{item.note}</span></li>)}
    </ol>
    <span class="ak-ghost" data-ghost={sector["ak-practice"].word} aria-hidden="true"></span>
  </section>

  {games.length > 0 && (
    <section class="ak-sector" id="ak-play" aria-labelledby="ak-play-title" data-ak-sector={sector["ak-play"].number} data-ak-word={sector["ak-play"].word}>
      <header class="ak-head">
        <span class="ak-head-no" aria-hidden="true">{sector["ak-play"].number}</span>
        <div><p class="ak-eyebrow" lang="en">// {sector["ak-play"].word}</p><h2 id="ak-play-title">{t("ema.about.gamesTitle")}</h2></div>
        <a class="ak-link" href={href("/games/")}>{t("ema.about.gamesAll").replace("{n}", String(gameShelf.length))}<Icon name="tabler:chevron-right" size={16} aria-hidden="true" /></a>
      </header>
      <ol class="ak-panels">
        {games.map((game, index) => {
          const Tag = game.url ? "a" : "div";
          return (
            <li>
              <Tag class="ak-panel" {...(game.url ? { href: game.url, target: "_blank", rel: "noopener noreferrer" } : {})}>
                <span class="ak-panel-art" aria-hidden="true">{game.art && <img src={game.art.src} alt="" loading="lazy" decoding="async" style={`object-position:${game.art.focus}`} />}</span>
                <span class="ak-panel-no" aria-hidden="true">{pad(index + 1)}</span>
                <span class="ak-panel-text">
                  <strong>{keepTails(game.title)}</strong>
                  <span>{game.subtitle}</span>
                </span>
                {game.url && <Icon class="ak-panel-go" name="tabler:external-link" size={18} aria-hidden="true" />}
              </Tag>
            </li>
          );
        })}
      </ol>
      <span class="ak-ghost" data-ghost={sector["ak-play"].word} aria-hidden="true"></span>
    </section>
  )}

  {currentSignals.length > 0 && (
    <section class="ak-sector ak-status" id="ak-status" aria-labelledby="ak-status-title" data-ak-sector={sector["ak-status"].number} data-ak-word={sector["ak-status"].word}>
      <span class="ak-lattice" aria-hidden="true"></span>
      <header class="ak-head">
        <span class="ak-head-no" aria-hidden="true">{sector["ak-status"].number}</span>
        <div><p class="ak-eyebrow" lang="en">// {sector["ak-status"].word}</p><h2 id="ak-status-title">{t("about.now")}</h2></div>
        <a class="ak-link" href={href("/about/")}>{t("common.moreNow")}<Icon name="tabler:chevron-right" size={16} aria-hidden="true" /></a>
      </header>
      <dl class="ak-signals">
        {currentSignals.map((signal, index) => <div><dt><span class="ak-signals-no" aria-hidden="true">{pad(index + 1)}</span>{signal.label}</dt><dd>{keepTails(signal.text)}</dd></div>)}
      </dl>
    </section>
  )}
</PageLayout>
