---
import "@/core/styles/scale.css";
import "@/core/fonts/subsets.css";
import "@/core/fonts/latin-quotes.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "../styles/theme.css";
import "../styles/journal.css";
import "../styles/motion.css";
import { Icon } from "astro-icon/components";
import { site } from "@/lib/site";
import { getI18n, localizePath } from "@/core/i18n";
import { getThemePath, stripTheme } from "@/core/themes/registry";
import LanguagePreference from "@/core/i18n/LanguagePreference.astro";
import LanguageSwitcher from "@/core/i18n/LanguageSwitcher.astro";
import ColorModePreference from "@/core/preferences/ColorModePreference.astro";
import SocialLinks from "@/core/components/SocialLinks.astro";
import ThemePreference from "@/core/themes/ThemePreference.astro";
import ThemeSwitcher from "@/core/themes/ThemeSwitcher.astro";
import SiteIcons from "@/core/components/SiteIcons.astro";
import SiteMeta from "@/core/components/SiteMeta.astro";
import SiteAttribution from "@/core/components/SiteAttribution.astro";
import SiteNavigation from "@/core/navigation/SiteNavigation.astro";
import FontLinks from "@/core/fonts/FontLinks.astro";
import CommandPalette from "@/core/components/CommandPalette.astro";
import { pageTransition } from "@/core/navigation/animations.mjs";
const { locale, t } = getI18n(Astro.url.pathname);
const href = (target: string) => getThemePath("blank", target, locale);
const path = stripTheme(Astro.url.pathname);
interface Props {
  title?: string;
  description?: string;
  isArticlePage?: boolean;
  article?: { pubDate: Date; updatedDate?: Date };
}
const { title = site.name, description = t("site.description"), isArticlePage = false, article } = Astro.props;
// The edition stamp beside the wordmark. The link's name repeats what it shows (wordmark, stamp), then says where it goes.
const edition = "BLANK / 01";
const navItems = site.nav.map((item, index) => ({
  ...item,
  label: t(`nav.${item.key}`),
  href: href(item.href),
  number: String(index + 1).padStart(2, "0"),
  active: item.href === "/" ? path === "/" : path.startsWith(item.href),
}));
---
<!doctype html>
<html lang={locale} data-theme="blank" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <LanguagePreference /><ThemePreference />
    <title>{title}</title>
    <ColorModePreference />
    {/* First full visit to the homepage: lets motion.css bring the hero in line by line. Set before the
        first paint so nothing shows and then hides; not set when motion is paused or reduced (the
        preference script above has already decided that), nor on in-site navigation, where the page
        transition introduces the page. Removed once the entrance is over. */}
    {path === "/" && <script is:inline>
      (() => {
        const html = document.documentElement;
        if (html.hasAttribute("data-astro-transition") || html.dataset.motionPaused === "true") return;
        html.dataset.intro = "";
        setTimeout(() => { delete html.dataset.intro; }, 1600);
      })();
    </script>}
    <SiteMeta title={title} description={description} siteName={site.name} isArticlePage={isArticlePage} article={article} />
    <SiteIcons />
    <FontLinks families={["noto-sans", "noto-serif"]} locale={locale} />
    <SiteNavigation />
  </head>
  <body data-blank>
    <a class="blank-skip-link" href="#blank-main">{t("a11y.skip")}</a>
    <header class="blank-header" data-site-header transition:name="site-header" transition:animate="none">
      <div class="blank-header-inner">
        <a class="blank-wordmark" href={href("/")} aria-label={`${site.wordmark} ${edition} ${t("a11y.home")}`}>
          <strong>{site.wordmark}<span aria-hidden="true">.</span></strong> <span class="blank-edition">{edition}</span>
        </a>
        <nav class="blank-nav" aria-label={t("a11y.navigation")}>
          {navItems.map((item) => <a href={item.href} aria-current={item.active ? "page" : undefined}><span class="blank-nav-number" aria-hidden="true">{item.number}</span>{item.label}</a>)}
        </nav>
        <div class="blank-header-actions">
          <LanguageSwitcher />
          <button class="blank-icon-button blank-theme-trigger blank-mode-toggle" type="button" data-color-mode-toggle hidden aria-label={t("mode.label")} aria-pressed="false" title={t("mode.toDark")} data-label-dark={t("mode.toDark")} data-label-light={t("mode.toLight")}>
            <span class="blank-mode-moon" aria-hidden="true"><Icon name="tabler:moon" size={19} /></span>
            <span class="blank-mode-sun" aria-hidden="true"><Icon name="tabler:sun" size={19} /></span>
          </button>
          <ThemeSwitcher floating />
        </div>
      </div>
      {isArticlePage && <div class="blank-reading-track" aria-hidden="true"><span data-site-progress></span></div>}
    </header>
    <main id="blank-main" class:list={["blank-main", { "blank-main--article": isArticlePage }]} tabindex="-1" transition:name="site-content" transition:animate={pageTransition}><slot /></main>
    <footer class="blank-footer">
      <div class="blank-footer-top">
        <a class="blank-footer-brand" href={href("/")}>{site.name}<span aria-hidden="true">.</span></a>
        <div class="bj-footer-links">
          <SocialLinks class="blank-footer-links" label={t("social.footerHeading")} />
          <a href={href("/about/")}>{t("common.about")} <Icon name="tabler:arrow-right" size={15} /></a>
        </div>
      </div>
      <div class="blank-footer-bottom">
        <SiteAttribution />
        <span>{t("home.statement2")}</span>
        <button class="site-cmdk-trigger" type="button" data-site-cmdk-open hidden>{t("cmdk.trigger")} <kbd data-site-cmdk-kbd aria-hidden="true">⌘K</kbd></button>
        <a href={localizePath("/rss.xml", locale)} data-astro-reload>RSS</a>
        <a href={href("/friends/")}>{t("footer.friends")}</a>
        <a href={href("/credits/")}>{t("footer.credits")}</a>
        <a href="#blank-main" class="blank-back-top">{t("footer.top")} <Icon name="tabler:arrow-up" size={14} /></a>
      </div>
    </footer>
    <CommandPalette />
    <script>
      import { registerThemeRuntime } from "@/core/themes/runtime.mjs";
      import { mountBlank } from "../lib/runtime.mjs";
      registerThemeRuntime("blank", mountBlank);
    </script>
  </body>
</html>
