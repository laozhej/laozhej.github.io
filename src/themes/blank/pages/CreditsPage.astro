---
import { Icon } from "astro-icon/components";
import { site } from "@/lib/site";
import { getThemedI18n as getI18n } from "@/core/themes/i18n";
import BlankLayout from "@/core/themes/PageLayout.astro";
import PageHead from "../components/PageHead.astro";
import themeLicense from "../../../../public/licenses/yuimi-chaya-MIT.txt?raw";
import iconLicense from "../../../../public/licenses/tabler-icons-MIT.txt?raw";
import fontLicense from "../../../../public/licenses/gloock-OFL.txt?raw";
import sairaLicense from "../../../../public/licenses/saira-OFL.txt?raw";
const { t, href } = getI18n(Astro.url.pathname);
---
<BlankLayout title={`${t("credits.title")} | ${site.name}`} description={t("credits.description")}>
  <PageHead index="05" title="Credits" label={t("credits.title")} description={t("credits.intro")} />
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">01 / THEME</p><h2>{t("credits.themeHeading")}</h2></div>
    <div class="blank-credits-body">
      <h3>Blank / Yuimi-chaya</h3>
      <p>{t("credits.themeText")}</p>
      <div class="blank-credits-links">
        <a class="blank-text-link" href="https://github.com/Yuimi-chaya/Yuimi-chaya.github.io" target="_blank" rel="noopener noreferrer">{t("credits.repository")} <Icon name="tabler:external-link" size={15} /></a>
        <a class="blank-text-link" href="https://yuimi-chaya.github.io/themes/blank/" target="_blank" rel="noopener noreferrer">{t("credits.originalTheme")} <Icon name="tabler:external-link" size={15} /></a>
      </div>
      <details class="blank-license">
        <summary>{t("credits.licenseText")} · MIT</summary>
        <pre lang="en">{themeLicense}</pre>
      </details>
      <a class="blank-text-link" href="/licenses/yuimi-chaya-MIT.txt">{t("credits.licenseFile")} <Icon name="tabler:arrow-right" size={16} /></a>
    </div>
  </section>
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">02 / ADAPTATION</p><h2>{t("credits.changesHeading")}</h2></div>
    <ul class="blank-credits-changes">{["credits.changeRoutes", "credits.changeContent", "credits.changeAppearance", "credits.changeLanguage"].map((key, index) => <li><span class="blank-row-number">{String(index + 1).padStart(2, "0")}</span><p>{t(key)}</p></li>)}</ul>
  </section>
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">03 / ICONS</p><h2>{t("credits.iconsHeading")}</h2></div>
    <div class="blank-credits-body">
      <h3>Tabler Icons</h3>
      <p>{t("credits.iconsText")}</p>
      <a class="blank-text-link" href="https://github.com/tabler/tabler-icons" target="_blank" rel="noopener noreferrer">{t("credits.iconProject")} <Icon name="tabler:external-link" size={15} /></a>
      <details class="blank-license">
        <summary>{t("credits.licenseText")} · MIT</summary>
        <pre lang="en">{iconLicense}</pre>
      </details>
      <a class="blank-text-link" href="/licenses/tabler-icons-MIT.txt">{t("credits.licenseFile")} <Icon name="tabler:arrow-right" size={16} /></a>
    </div>
  </section>
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">04 / FONTS</p><h2>{t("credits.fontsHeading")}</h2></div>
    <div class="blank-credits-body">
      <h3>Gloock</h3>
      <p>{t("credits.fontsText")}</p>
      <a class="blank-text-link" href="https://github.com/duartp/gloock" target="_blank" rel="noopener noreferrer">{t("credits.fontProject")} <Icon name="tabler:external-link" size={15} /></a>
      <details class="blank-license">
        <summary>{t("credits.licenseText")} · OFL-1.1</summary>
        <pre lang="en">{fontLicense}</pre>
      </details>
      <a class="blank-text-link" href="/licenses/gloock-OFL.txt">{t("credits.licenseFile")} <Icon name="tabler:arrow-right" size={16} /></a>
      <h3>Saira</h3>
      <p>{t("credits.sairaText")}</p>
      <a class="blank-text-link" href="https://github.com/Omnibus-Type/Saira" target="_blank" rel="noopener noreferrer">{t("credits.sairaProject")} <Icon name="tabler:external-link" size={15} /></a>
      <details class="blank-license">
        <summary>{t("credits.licenseText")} · OFL-1.1</summary>
        <pre lang="en">{sairaLicense}</pre>
      </details>
      <a class="blank-text-link" href="/licenses/saira-OFL.txt">{t("credits.licenseFile")} <Icon name="tabler:arrow-right" size={16} /></a>
    </div>
  </section>
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">05 / CONTENT</p><h2>{t("credits.contentHeading")}</h2></div>
    <div class="blank-credits-body">
      <p>{t("credits.contentText")}</p>
      <p>{t("credits.mediaText")}</p>
      <p>{t("credits.scopeText")}</p>
      <a class="blank-text-link" href={href("/")}>{t("credits.back")} <Icon name="tabler:arrow-right" size={17} /></a>
    </div>
  </section>
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">06 / EMA</p><h2>{t("media.heading")}</h2></div>
    <div class="blank-credits-body">
      <p>{t("media.motion")}</p>
      <a class="blank-text-link" href="https://yuimi-chaya.github.io/themes/fuyukawa-kagari/" target="_blank" rel="noopener noreferrer">{t("media.reference")} ↗</a>
      <p>{t("media.sources")}</p><p>{t("media.alice")}</p>
      <p>{t("media.manga")}</p>
      <a class="blank-text-link" href="https://www.sunday-webry.com/episode/3269754496548997914" target="_blank" rel="noopener noreferrer">{t("media.mangaSource")} ↗</a>
      <p>{t("media.rights")}</p>
      <a class="blank-text-link" href="/themes/ema/ASSETS.json">{t("media.manifest")} ↗</a>
      <p>{t("media.games")}</p>
      <a class="blank-text-link" href="/games/ASSETS.json">{t("media.gamesManifest")} ↗</a>
      <a class="blank-text-link" href="/characters/ASSETS.json">{t("media.charactersManifest")} ↗</a>
      <a class="blank-text-link" href="/animes/ASSETS.json">{t("media.animesManifest")} ↗</a>
    </div>
  </section>
  <section class="blank-section blank-about-section blank-credits-section">
    <div><p class="blank-kicker">07 / LIVE2D</p><h2>{t("media.mascotHeading")}</h2></div>
    <div class="blank-credits-body">
      <h3>Frieren / kyokiStudio</h3>
      <p>{t("media.mascot")}</p>
      <p>{t("media.mascotTerms")}</p>
      <a class="blank-text-link" href="https://booth.pm/ja/items/5323958" target="_blank" rel="noopener noreferrer">{t("media.mascotSource")} <Icon name="tabler:external-link" size={15} /></a>
      <p>{t("media.live2dSoftware")}</p>
      <div class="blank-credits-links">
        <a class="blank-text-link" href="/licenses/pixi-MIT.txt">PixiJS · MIT <Icon name="tabler:arrow-right" size={16} /></a>
        <a class="blank-text-link" href="/licenses/pixi-live2d-display-MIT.txt">pixi-live2d-display · MIT <Icon name="tabler:arrow-right" size={16} /></a>
        <a class="blank-text-link" href="/vendor/live2d/5-r.4/LICENSE.md">{t("media.coreLicense")} <Icon name="tabler:arrow-right" size={16} /></a>
        <a class="blank-text-link" href="https://www.live2d.com/eula/live2d-open-software-license-agreement_en.html" target="_blank" rel="noopener noreferrer">{t("media.frameworkLicense")} <Icon name="tabler:external-link" size={15} /></a>
      </div>
    </div>
  </section>
</BlankLayout>
