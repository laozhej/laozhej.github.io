---
// Blank homepage, rebuilt on the reference's redesigned Blank home (Yuimi-chaya/Yuimi-chaya.github.io,
// src/themes/blank/pages/HomePage.astro, MIT; mapping in docs/REFERENCE.md): a typographic journal with
// a giant wordmark, a two-line statement beside the owner's introduction, a numbered index strip, the
// latest writing in a black band followed by numbered rows, the practice list and one current signal.
// Everything shown comes from the shared sources; with no posts the writing section says so.
import { Icon } from "astro-icon/components";
import { getSiteContent } from "@/core/i18n/content";
import { site } from "@/lib/site";
import { getThemedI18n as getI18n } from "@/core/themes/i18n";
import BlankLayout from "@/core/themes/PageLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { keepTails } from "@/core/i18n/wrap.mjs";
const { locale, t, href, formatDate, categoryLabel } = getI18n(Astro.url.pathname);
const { currentSignals, gameShelf, profileIdentity, profileTech, projectEntries } = getSiteContent(locale);
const posts = await getPublishedPosts(locale);
const [featured, ...remaining] = posts;
const pad = (value: number) => String(value).padStart(2, "0");
const count = (value: number, one: string, many: string) => `${pad(value)} ${t(value === 1 ? one : many)}`;
const featuredDate = featured && (featured.data.updatedDate ?? featured.data.pubDate);
const firstSection = posts.length > 0 ? "#blank-latest" : "#blank-writing";
---

<BlankLayout title={`${site.name} | ${t("home.title")}`} description={t("home.description")}>
  <section class="bj-hero" aria-labelledby="blank-home-title">
    <div class="bj-topline"><p class="blank-kicker">{t("home.kicker")}</p><span class="blank-kicker">BY {site.owner.toUpperCase()}</span></div>
    <h1 id="blank-home-title">{site.name}<span aria-hidden="true">.</span></h1>
    <div class="bj-bottom">
      <p class="bj-statement">{t("home.statement1")}<br />{t("home.statement2")}</p>
      <div class="bj-intro">
        <p>{keepTails(profileIdentity.bio)}</p>
        <a class="blank-text-link" href={href("/about/")}>{t("common.about")} <Icon name="tabler:arrow-right" size={17} /></a>
      </div>
      <a class="bj-down" href={firstSection} aria-label={posts.length > 0 ? t("home.latestLink") : t("home.latest")} title={posts.length > 0 ? t("home.latestLink") : t("home.latest")}><Icon name="tabler:arrow-down" size={24} /></a>
    </div>
    <nav class="bj-index" aria-label={t("a11y.navigation")}>
      <a href={href("/blog/")}><span>{t("home.writingIndex")}</span><strong>{count(posts.length, "common.entriesOne", "common.entries")}</strong></a>
      <a href={href("/projects/")}><span>{t("home.practiceIndex")}</span><strong>{count(projectEntries.length, "common.projectsOne", "common.projects")}</strong></a>
      <a href={href("/games/")}><span>{t("home.playIndex")}</span><strong>{gameShelf.length > 0 ? count(gameShelf.length, "common.gamesOne", "common.games") : t("home.playHint")}</strong></a>
    </nav>
  </section>

  <section id="blank-writing" class="bj-section" aria-labelledby="blank-writing-title">
    <div class="blank-section-heading"><div><p class="blank-kicker">01 / WRITING</p><h2 id="blank-writing-title">{t("home.latest")}</h2></div>{posts.length > 0 && <a class="blank-text-link" href={href("/blog/")}>{t("common.allArticles")} <Icon name="tabler:arrow-right" size={18} /></a>}</div>
    {featured && (
      <a id="blank-latest" class="bj-featured" href={href(`/blog/${featured.slug}/`)}>
        <div class="bj-featured-margin"><span class="blank-kicker">LATEST ENTRY</span><span class="bj-featured-number" aria-hidden="true">01</span></div>
        <div class="bj-featured-content">
          <div class="blank-post-meta"><span>{categoryLabel[featured.data.category]}</span><time datetime={featuredDate.toISOString()}>{formatDate(featuredDate)}</time></div>
          <h2 lang={featured.data.locale}>{keepTails(featured.data.title)}</h2>
          <p lang={featured.data.locale}>{featured.data.description}</p>
          {featured.data.locale !== locale && <p class="bj-fallback">{t("article.originalLanguage")}</p>}
          <span class="blank-text-link">{t("common.readMore")} <Icon name="tabler:arrow-right" size={19} /></span>
        </div>
      </a>
    )}
    {remaining.length > 0 && (
      <ol class="bj-rows">
        {remaining.slice(0, 3).map((post, index) => {
          const date = post.data.updatedDate ?? post.data.pubDate;
          return (
            <li><a class="blank-post-row" href={href(`/blog/${post.slug}/`)}>
              <span class="blank-row-number">{pad(index + 2)}</span>
              <span class="blank-post-content">
                <span class="blank-post-meta"><span>{categoryLabel[post.data.category]}</span><time datetime={date.toISOString()}>{formatDate(date)}</time></span>
                <h3 lang={post.data.locale}>{keepTails(post.data.title)}</h3>
                <span class="bj-row-summary" lang={post.data.locale}>{post.data.description}</span>
              </span>
              <Icon name="tabler:arrow-right" class="blank-row-arrow" size={20} />
            </a></li>
          );
        })}
      </ol>
    )}
    {posts.length === 0 && <p class="bj-empty">{t("blog.empty")}</p>}
  </section>

  {profileTech.length > 0 && (
    <section class="bj-section bj-workbench" aria-labelledby="blank-practice-title">
      <div class="blank-section-heading"><div><p class="blank-kicker">02 / IN PRACTICE</p><h2 id="blank-practice-title">{t("home.inProgress")}</h2></div><a class="blank-text-link" href={href("/projects/")}>{t("common.projectNotes")} <Icon name="tabler:arrow-right" size={18} /></a></div>
      <div class="bj-workbench-body">
        <p class="bj-section-intro">{t("home.practice1")}<br />{t("home.practice2")}</p>
        <dl class="bj-tech-list">{profileTech.map((item, index) => <div><dt><span class="blank-row-number">{pad(index + 1)}</span>{item.name}</dt><dd>{item.note}</dd></div>)}</dl>
      </div>
    </section>
  )}

  {currentSignals.length > 0 && (
    <section class="bj-now" aria-label={t("home.currently")}>
      <p class="blank-kicker">{t("home.currently")}</p>
      <p>{keepTails(currentSignals[0].text)}</p>
      <a class="blank-text-link" href={href("/about/")}>{t("common.moreNow")} <Icon name="tabler:arrow-right" size={17} /></a>
    </section>
  )}
</BlankLayout>
