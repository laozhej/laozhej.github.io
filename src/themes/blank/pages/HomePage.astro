---
import { getSiteContent } from "@/core/i18n/content";
import { site } from "@/lib/site";
import { getThemedI18n as getI18n } from "@/core/themes/i18n";
import { Icon } from "astro-icon/components";
import BlankLayout from "@/core/themes/PageLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { socialLinks } from "@/core/data/social";
import { keepTails } from "@/core/i18n/wrap.mjs";
const { locale, t, href, formatDate } = getI18n(Astro.url.pathname);
const { animeFavorites, currentSignals, favoriteGames, gameShelf, profileIdentity, projectEntries, xpFavorites } = getSiteContent(locale);
const [project] = projectEntries;

const posts = (await getPublishedPosts(locale)).slice(0, 3);
// One small sheet in the owner's own order: the top two games, then the top anime and character.
const favorites = [
  ...favoriteGames.slice(0, 2).map((game) => {
    const art = gameShelf.find((item) => item.key === game.key)?.art;
    return { kind: t("ema.about.gamesMark"), title: game.title, url: game.url, external: true, image: art?.src, focus: art?.focus };
  }),
  ...animeFavorites.slice(0, 1).map((anime) => ({ kind: t("ema.about.animesMark"), title: anime.title, url: anime.url, external: true, image: anime.cover })),
  ...xpFavorites.slice(0, 1).map((character) => ({ kind: t("ema.about.charactersMark"), title: character.title, url: href("/about/"), image: character.portrait, portrait: true })),
].filter((item) => item.image);
---

<BlankLayout title={`${site.name} | ${t("home.title")}`} description={t("home.description")}>
  <section class="blank-home-hero" aria-labelledby="blank-home-title">
    <div class="blank-home-owner">
      <img src={profileIdentity.avatar} alt={t("ema.about.avatar").replace("{name}", profileIdentity.displayName)} width="104" height="104" decoding="async" />
      <h1 id="blank-home-title">{profileIdentity.displayName} <span>{profileIdentity.alias}</span></h1>
      <p>{keepTails(profileIdentity.intro)}</p>
    </div>
    <div class="blank-home-links">
      <a class="blank-text-link" href={href("/about/")}>{t("common.about")} <Icon name="tabler:arrow-right" size={17} /></a>
      {socialLinks.map((social) => <a class="blank-text-link" href={social.href} target="_blank" rel="me noopener noreferrer" aria-label={t(`social.${social.key}`)}>{social.label} <Icon name="tabler:arrow-up-right" size={17} /></a>)}
    </div>
  </section>

  {project && (
    <section class="blank-home-project" aria-labelledby="blank-home-project">
      <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} fetchpriority="high" decoding="async" />
      <div class="blank-home-project-copy">
        <span class="blank-project-status">{project.status}</span>
        <h2 id="blank-home-project">{keepTails(project.title)}</h2>
        <p>{keepTails(project.summary)}</p>
        <div class="blank-home-project-links">
          <a class="blank-button" href={project.url}>{t("projects.caseStudy")} <Icon name="tabler:arrow-up-right" size={17} /></a>
          <a class="blank-button blank-button--outline" href={href("/projects/")}>{t("common.projectNotes")} <Icon name="tabler:arrow-right" size={17} /></a>
        </div>
      </div>
    </section>
  )}

  <div class="blank-home-band">
    <div class="blank-home-side">
      <section aria-labelledby="blank-home-now">
        <h2 id="blank-home-now">{t("about.now")}</h2>
        <dl class="blank-home-signals">{currentSignals.slice(0, 2).map((item) => <div><dt>{item.label}</dt><dd>{keepTails(item.text)}</dd></div>)}</dl>
        <a class="blank-text-link" href={href("/about/")}>{t("common.moreNow")} <Icon name="tabler:arrow-right" size={17} /></a>
      </section>
      {posts.length > 0 && (
        <section aria-labelledby="blank-home-writing">
          <h2 id="blank-home-writing">{t("nav.blog")}</h2>
          <ol class="blank-home-posts">{posts.map((post) => {
            const date = post.data.updatedDate ?? post.data.pubDate;
            return <li><a href={href(`/blog/${post.slug}/`)}><time datetime={date.toISOString()}>{formatDate(date)}</time><span lang={post.data.locale}>{keepTails(post.data.title)}</span>{post.data.locale !== locale && <small>{t("article.originalLanguage")}</small>}</a></li>;
          })}</ol>
          <a class="blank-text-link" href={href("/blog/")}>{t("common.allArticles")} <Icon name="tabler:arrow-right" size={17} /></a>
        </section>
      )}
    </div>

    <section class="blank-home-favorites" aria-labelledby="blank-home-favorites">
      <div class="blank-home-favorites-head">
        <h2 id="blank-home-favorites">{t("about.favorites")}</h2>
        <div>
          <a class="blank-text-link" href={href("/games/")}>{t("ema.about.gamesAll").replace("{n}", String(gameShelf.length))} <Icon name="tabler:arrow-right" size={17} /></a>
          <a class="blank-text-link" href={href("/about/")}>{t("home.favoritesAll")} <Icon name="tabler:arrow-right" size={17} /></a>
        </div>
      </div>
      <ul class="blank-home-sheet">
        {favorites.map((item) => (
          <li class:list={{ "is-portrait": item.portrait }}>
            <a href={item.url} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
              <img src={item.image} alt="" width="480" height="432" loading="lazy" decoding="async" style={item.focus ? `object-position:${item.focus}` : undefined} />
              <span>{item.kind}</span>
              <strong>{keepTails(item.title)}</strong>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BlankLayout>
