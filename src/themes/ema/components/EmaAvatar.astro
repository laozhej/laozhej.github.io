---
import assets from "../../../../public/themes/ema/ASSETS.json";

interface Props {
  class: string;
  alt: string;
  loading?: "lazy" | "eager";
}

const { class: className, alt, loading = "lazy" } = Astro.props;
const { file, sha256, dimensions: [width, height] } = assets.assets.find(({ id }) => id === "profile-avatar")!;
---
<img class={className} src={`/themes/ema/${file}?v=${sha256.slice(0, 12)}`} {alt} {width} {height} {loading} decoding="async" draggable="false" />
