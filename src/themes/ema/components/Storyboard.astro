---
// The stage's back layer: a curated manga storyboard spread pairing owner-supplied non-AI fan manga
// panels (recorded in public/themes/ema/ASSETS.json) with quiet screentone, hatching and sakura
// breather panels. The panels behind the hero copy and directly behind Ema stay light and open,
// while the visible right side and lower-left showcase crisp cropped panels.
// Light mode blends ink onto cream paper; dark mode keeps positive polarity by multiplying manga
// ink onto a muted moonlit plum-grey paper stock so faces stay natural rather than photo-negative.
import { petal } from "../lib/still-life.mjs";
const W = 1600, H = 900;
type Panel = {
  x: number;
  y: number;
  w: number;
  h: number;
  tone: string;
  art?: string;
  align?: string;
  motif?: string;
  skew?: number;
};
const panels: Panel[] = [
  // Left page (x: 16..784)
  // L1: upper-left breather reserved for the CC0 cherry branch overlay
  { x: 16, y: 16, w: 288, h: 226, tone: "dots" },
  // L2: upper-mid wide strip below the nav pill
  { x: 318, y: 16, w: 466, h: 184, tone: "plain", art: "/themes/ema/storyboard/panel-09-fast-eat-duo.webp", align: "xMidYMax slice" },
  // L3: quiet breather directly behind the hero title, diary line and terminal card
  { x: 16, y: 256, w: 522, h: 312, tone: "fade" },
  // L4: soft sakura breather to Ema's left shoulder
  { x: 552, y: 214, w: 232, h: 354, tone: "dots-lav", motif: "petals" },
  // L5: lower-left hero showcase panel (fully visible below ~/sakura.sh)
  { x: 16, y: 582, w: 492, h: 302, tone: "plain", art: "/themes/ema/storyboard/panel-07-hanami.webp", align: "xMaxYMin slice" },
  // L6: lower-mid-left showcase panel beside Ema's left hem
  { x: 522, y: 582, w: 262, h: 302, tone: "plain", art: "/themes/ema/storyboard/panel-08-cocoa-wave.webp", align: "xMidYMin slice" },

  // Right page (x: 816..1584)
  // M1: upper-mid-right panel (also peeks nicely on portrait phones)
  { x: 816, y: 16, w: 266, h: 226, tone: "plain", art: "/themes/ema/storyboard/panel-06-plushie-doll.webp", align: "xMidYMax slice" },
  // R1: upper-right wide panel (kimono amazake scene, aligned low to clear header controls)
  { x: 1096, y: 16, w: 488, h: 226, tone: "plain", art: "/themes/ema/storyboard/panel-01-amazake.webp", align: "xMidYMax slice" },
  // M2: calm breather directly behind Ema's right silhouette
  { x: 816, y: 256, w: 266, h: 312, tone: "hatch", motif: "petals" },
  // R2: primary right-center focal panel (puffed-cheek Ema close-up)
  { x: 1096, y: 256, w: 256, h: 312, tone: "plain", art: "/themes/ema/storyboard/panel-02-puffed-ema.webp", align: "xMidYMid slice" },
  // R3: far-right tall portrait (white-haired Ema with sakura eye)
  { x: 1366, y: 256, w: 218, h: 312, tone: "plain", art: "/themes/ema/storyboard/panel-03-zankoroku-ema.webp", align: "xMinYMin slice" },
  // M3: lower-mid-right panel peeking beside Ema's right hem
  { x: 816, y: 582, w: 266, h: 302, tone: "plain", art: "/themes/ema/storyboard/panel-10-sherry-hanna.webp", align: "xMidYMin slice" },
  // R4: lower-right focal panel (Hiro hugging Ema plushie)
  { x: 1096, y: 582, w: 256, h: 302, tone: "plain", art: "/themes/ema/storyboard/panel-05-plushie-hug.webp", align: "xMidYMid slice" },
  // R5: far-right lower portrait pairing R3 (dark-haired Hiro with sakura eye)
  { x: 1366, y: 582, w: 218, h: 302, tone: "plain", art: "/themes/ema/storyboard/panel-04-zankoroku-hiro.webp", align: "xMinYMin slice" },
];
const loose = (cx: number, cy: number, r: number, turn: number) =>
  `<path d="${petal}" transform="translate(${cx.toFixed(1)} ${cy.toFixed(1)}) rotate(${turn}) scale(${r.toFixed(1)})"/>`;
const rand = (seed: number) => { const x = Math.sin(seed * 9301 + 49297) * 233280; return x - Math.floor(x); };
const clipId = (i: number) => `sb-clip-${i}`;
const shape = (p: Panel) => p.skew
  ? `M${p.x} ${p.y} L${p.x + p.w} ${p.y + (p.skew > 0 ? p.skew : 0)} L${p.x + p.w} ${p.y + p.h} L${p.x} ${p.y + p.h - (p.skew < 0 ? -p.skew : 0)} Z`
  : `M${p.x} ${p.y} h${p.w} v${p.h} h${-p.w} Z`;
function motif(p: Panel, i: number) {
  if (p.motif === "petals") {
    return `<g class="sb-petal">${Array.from({ length: 7 }, (_, k) =>
      loose(
        p.x + p.w * (0.12 + 0.76 * rand(i * 13 + k)),
        p.y + p.h * (0.12 + 0.76 * rand(i * 7 + k * 3)),
        9 + 8 * rand(i + k * 5),
        Math.round(360 * rand(i * 3 + k))
      )
    ).join("")}</g>`;
  }
  return "";
}
const body = panels.map((p, i) => {
  const fill = { dots: "url(#sb-dots)", "dots-lav": "url(#sb-dots-lav)", hatch: "url(#sb-hatch)", fade: "url(#sb-dots)", "fade-lav": "url(#sb-dots-lav)" }[p.tone];
  const tone = fill ? `<rect x="${p.x}" y="${p.y}" width="${p.w}" height="${p.h}" fill="${fill}"${p.tone.startsWith("fade") ? ` mask="url(#sb-fade)"` : ""}/>` : "";
  const art = p.art
    ? `<image class="sb-art" href="${p.art}" x="${p.x}" y="${p.y}" width="${p.w}" height="${p.h}" preserveAspectRatio="${p.align ?? "xMidYMid slice"}" decoding="async"/>`
    : "";
  return `<g class="sb-cell" clip-path="url(#${clipId(i)})"><path class="sb-paper" d="${shape(p)}"/>${tone}${art}${motif(p, i)}</g><path class="sb-frame" d="${shape(p)}"/>`;
}).join("");
const clips = panels.map((p, i) => `<clipPath id="${clipId(i)}"><path d="${shape(p)}"/></clipPath>`).join("");
---
<svg class="sb" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="sb-dots" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><circle cx="4.5" cy="4.5" r="1.7" class="sb-dot" /></pattern>
    <pattern id="sb-dots-lav" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><circle cx="4" cy="4" r="1.5" class="sb-dot-lav" /></pattern>
    <pattern id="sb-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)"><path d="M0 5 H10" class="sb-hatch" /></pattern>
    <linearGradient id="sb-fade-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
    <mask id="sb-fade" maskContentUnits="objectBoundingBox"><rect width="1" height="1" fill="url(#sb-fade-g)" /></mask>
    <Fragment set:html={clips} />
  </defs>
  <Fragment set:html={body} />
</svg>
