---
import "@/core/styles/scale.css";
import "@/core/fonts/subsets.css";
import "@/themes/blank/styles/theme.css";
import "@fontsource/gloock/latin-400.css";
import "@fontsource-variable/nunito/wght.css";
import nunitoLatin from "@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url";
import "../styles/theme.css";
import "../styles/plate.css";
import "../styles/article.css";
import "../styles/works.css";
import { Icon } from "astro-icon/components";
import { site } from "@/lib/site";
import { getI18n } from "@/core/i18n";
import { getThemePath, stripTheme } from "@/core/themes/registry";
import ThemePreference from "@/core/themes/ThemePreference.astro";
import ThemeSwitcher from "@/core/themes/ThemeSwitcher.astro";
import LanguagePreference from "@/core/i18n/LanguagePreference.astro";
import LanguageSwitcher from "@/core/i18n/LanguageSwitcher.astro";
import ColorModePreference from "@/core/preferences/ColorModePreference.astro";
import SiteIcons from "@/core/components/SiteIcons.astro";
import SiteMeta from "@/core/components/SiteMeta.astro";
import SiteAttribution from "@/core/components/SiteAttribution.astro";
import SocialLinks from "@/core/components/SocialLinks.astro";
import SiteNavigation from "@/core/navigation/SiteNavigation.astro";
import FontLinks from "@/core/fonts/FontLinks.astro";
import { pageTransition } from "@/core/navigation/animations.mjs";
import { TRACKS } from "../lib/radio.mjs";
const { locale, t } = getI18n(Astro.url.pathname);
const trackNames = TRACKS.map(({ id }) => t(`ema.radio.${id}`));
const href = (path: string) => getThemePath("ema", path, locale);
const path = stripTheme(Astro.url.pathname);
// `cursorRing` (Home and Games) adds the cursor ring's switch to the console; the ring runs only where it is rendered.
const { title: pageTitle = site.name, description = t("site.description"), isArticlePage = false, article, home = false, cursorRing = false } = Astro.props;
// Sakura Archive carries its own name; shared pages still pass the shared site name.
const brand = t("ema.brand");
const title = pageTitle.replaceAll(site.name, brand);
const [brandHead, ...brandTail] = brand.split(" ");
// The edition stamp beside the name. The header link's name repeats what it shows (name, stamp), then says where it goes.
const edition = "EMA / 02";
// Deterministic petal paths so every page and locale renders the same markup.
// The reference's navigation pairs an icon and a label with a small Latin hint (decorative, hidden from screen readers).
const navIcons: Record<string, string> = { home: "tabler:home", blog: "tabler:notebook", projects: "tabler:code", games: "tabler:device-gamepad-2", about: "tabler:user-heart" };
const navHints: Record<string, string> = { home: "front page", blog: "notes", projects: "works", games: "playroom", about: "profile" };
// Three depths, interleaved so every cut-off below keeps a mix: far petals are small, faint and slow,
// near ones large and quick. Golden-ratio steps spread them across the width without a visible column order,
// and negative delays put the whole fall on screen from the first frame.
const petalDepths = [
  { size: 10, spread: 3, opacity: 0.6, duration: 19, drift: 50, sway: 10 },
  { size: 14, spread: 4, opacity: 0.82, duration: 14, drift: 80, sway: 16 },
  { size: 19, spread: 6, opacity: 0.95, duration: 10, drift: 120, sway: 24 },
];
const petals = Array.from({ length: 42 }, (_, index) => {
  const depth = petalDepths[index % 3];
  const step = (index * 0.618034) % 1;
  const phase = (index * 0.381966 + 0.17) % 1;
  const duration = depth.duration + (index * 7) % 5;
  const drift = depth.drift * (index % 2 ? 1 : -0.7);
  return `--petal-left:${(1 + step * 97).toFixed(1)}%;--petal-size:${depth.size + (index * 5) % depth.spread}px;--petal-opacity:${depth.opacity};--petal-duration:${duration}s;--petal-delay:${(-phase * duration).toFixed(1)}s;--petal-drift:${drift.toFixed(0)}px;--petal-sway:${depth.sway}px;--petal-flutter:${(4 + (index * 3) % 4).toFixed(1)}s`;
});
---
<!doctype html>
<html lang={locale} data-theme="ema" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <LanguagePreference /><ThemePreference /><SiteIcons />
    <ColorModePreference lightColor="#fbf7ef" darkColor="#201f28" />
    {/* First full visit to the homepage: lets stage.css bring the stage in (paper, Ema, then the words).
        Set before the first paint; not when motion is paused or reduced, nor on in-site navigation, where
        the page transition introduces the page. Removed once the entrance is over. */}
    {home && <script is:inline>
      (() => {
        const html = document.documentElement;
        if (html.hasAttribute("data-astro-transition") || html.dataset.motionPaused === "true") return;
        html.dataset.intro = "";
        setTimeout(() => { delete html.dataset.intro; }, 2000);
      })();
    </script>}
    <title>{title}</title><SiteMeta title={title} description={description} siteName={brand} isArticlePage={isArticlePage} article={article} />
    <FontLinks families={["ema-text", "noto-serif"]} locale={locale} />
    {locale === "en" && <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />}
    <SiteNavigation />
  </head>
  <body data-blank data-ema data-ema-home={home ? "" : undefined}>
    <a class="blank-skip-link" href="#ema-main">{t("a11y.skip")}</a>
    <header class="ema-header" data-header data-site-header transition:name="site-header" transition:animate="none">
      <a class="ema-wordmark" href={href("/")} aria-label={`${brand} ${edition} ${t("a11y.home")}`}><span class="ema-mark" aria-hidden="true"><svg viewBox="-12 -12 24 24" width="30" height="30"><g>{[0, 72, 144, 216, 288].map((turn) => <path d="M0 0 C-4.2 -3.6 -5 -8.6 -2 -10 L0 -8.6 L2 -10 C5 -8.6 4.2 -3.6 0 0 Z" transform={`rotate(${turn})`} />)}</g><circle r="1.6" /></svg></span><strong><span>{brandHead.split(/(\.)/).map((part) => part === "." ? <i>.</i> : part)}</span> <span>{brandTail.join(" ")}</span></strong> <small>{edition}</small></a>
      <nav class="ema-nav" aria-label={t("a11y.navigation")}>{site.nav.map(item => <a href={href(item.href)} aria-current={(item.href === "/" ? path === "/" : path.startsWith(item.href)) ? "page" : undefined}><span class="ema-nav-icon" aria-hidden="true"><Icon name={navIcons[item.key]} size={17} /></span><span class="ema-nav-label">{t(`nav.${item.key}`)}</span><span class="ema-nav-hint" aria-hidden="true">{navHints[item.key]}</span></a>)}</nav>
      <div class="ema-header-actions">
        <button class="ema-settings-toggle" type="button" data-ema-settings-toggle aria-expanded="false" aria-controls="ema-controls" aria-label={t("ema.home.settings")} title={t("ema.home.settings")} hidden><Icon name="tabler:adjustments-horizontal" size={19} aria-hidden="true" /></button>
        <div class="ema-controls" id="ema-controls" data-ema-controls>
          <LanguageSwitcher />
          <button class="ema-icon-button" type="button" data-color-mode-toggle hidden aria-label={t("mode.label")} aria-pressed="false" title={t("mode.toDark")} data-label-dark={t("mode.toDark")} data-label-light={t("mode.toLight")}><span class="blank-mode-moon"><Icon name="tabler:moon" size={18} /></span><span class="blank-mode-sun"><Icon name="tabler:sun" size={18} /></span></button>
          <button class="ema-motion-toggle" type="button" data-motion-toggle data-motion-pause={t("ema.motion.pause")} data-motion-resume={t("ema.motion.resume")} data-motion-reduced={t("ema.motion.reduced")} hidden aria-pressed="false" aria-label={t("ema.motion.pause")} title={t("ema.motion.pause")}><Icon name="tabler:player-pause" size={18} data-motion-pause-icon aria-hidden="true" /><Icon name="tabler:player-play" size={18} data-motion-play-icon aria-hidden="true" hidden /><span class="ema-motion-label">{t("ema.motion.short")}</span></button>
          <div class="ema-theme-docked"><ThemeSwitcher floating /></div>
        </div>
      </div>
      {isArticlePage && <div class="blank-reading-track" aria-hidden="true"><span data-site-progress></span></div>}
    </header>
    <main id="ema-main" class:list={[{ "ema-content blank-main": !home, "ema-home-main": home, "blank-main--article": isArticlePage }]} tabindex="-1" transition:name="site-content" transition:animate={pageTransition}><slot /></main>
    <footer class="ema-footer">
      <a class="ema-footer-brand" href={href("/")}>{brand.split(/(\.)/).map((part) => part === "." ? <span>.</span> : part)}</a>
      <p>{t("home.statement2")}</p>
      <SocialLinks class="ema-social-links" label={t("social.footerHeading")} />
      <div class="ema-footer-bottom"><SiteAttribution /><a href={href("/credits/")}>{t("footer.credits")}</a><button class="ema-console-dock" type="button" data-console-toggle aria-expanded="false" aria-controls="ema-console-panel" hidden><Icon name="tabler:music" size={14} aria-hidden="true" />{t("ema.console.tab")}</button><a href="#ema-main" data-site-top>{t("footer.top")} ↑</a></div>
    </footer>
    <div class="ema-theme-floating"><ThemeSwitcher floating /></div>
    <div class="ema-console" data-ema-console>
      <button class="console-tab" type="button" data-console-toggle aria-expanded="false" aria-controls="ema-console-panel" hidden><Icon name="tabler:music" size={16} aria-hidden="true" /><span>{t("ema.console.tab")}</span></button>
      <section class="console-panel" id="ema-console-panel" data-console-panel aria-label={t("ema.console.label")} hidden>
        <div class="console-head"><p>{t("ema.console.label")}</p><button type="button" data-console-close aria-label={t("ema.console.close")} title={t("ema.console.close")}><Icon name="tabler:x" size={15} /></button></div>
        <div class="console-card radio" data-radio data-tracks={JSON.stringify(trackNames)}>
          <div class="radio-head"><span class="radio-disc" aria-hidden="true"></span><div><p class="console-kicker">{t("ema.radio.label")}</p><strong data-radio-title>{trackNames[0]}</strong><small data-radio-count>1 / {trackNames.length}</small></div></div>
          <div class="radio-progress" aria-hidden="true"><span data-radio-progress></span></div>
          <div class="radio-time" aria-hidden="true"><span data-radio-elapsed>00:00</span><span data-radio-length>00:00</span></div>
          <div class="radio-controls">
            <button type="button" data-radio-prev aria-label={t("ema.radio.previous")} title={t("ema.radio.previous")}><Icon name="tabler:player-skip-back" size={17} /></button>
            <button class="radio-play" type="button" data-radio-play aria-pressed="false" aria-label={t("ema.radio.play")} title={t("ema.radio.play")} data-play={t("ema.radio.play")} data-pause={t("ema.radio.pause")}><Icon name="tabler:player-play" size={20} data-radio-play-icon /><Icon name="tabler:player-pause" size={20} data-radio-pause-icon hidden /></button>
            <button type="button" data-radio-next aria-label={t("ema.radio.next")} title={t("ema.radio.next")}><Icon name="tabler:player-skip-forward" size={17} /></button>
          </div>
          <label class="radio-volume"><Icon name="tabler:volume" size={16} aria-hidden="true" /><span class="blank-sr-only">{t("ema.radio.volume")}</span><input type="range" min="0" max="100" value="60" data-radio-volume /></label>
          <p class="radio-note">{t("ema.radio.credit")}</p>
          <p class="radio-note" data-radio-unsupported hidden>{t("ema.radio.unsupported")}</p>
          <p class="radio-note" data-radio-error role="status" hidden>{t("ema.radio.error")}</p>
        </div>
        {cursorRing && (
          <div class="console-card ring-card" data-ring-card hidden>
            <button class="ring-switch" type="button" role="switch" aria-checked="true" aria-describedby="ema-ring-note ema-ring-status" data-ring-toggle><span>{t("ema.ring.label")}</span><span class="ring-switch-state" aria-hidden="true"><span data-ring-state data-on={t("ema.ring.on")} data-off={t("ema.ring.off")}>{t("ema.ring.on")}</span><span class="ring-switch-track"></span></span></button>
            <p class="radio-note" id="ema-ring-note">{t("ema.ring.note")}</p>
            <p class="radio-note" id="ema-ring-status" data-ring-status data-paused={t("ema.ring.paused")} data-reduced={t("ema.ring.reduced")} hidden></p>
          </div>
        )}
      </section>
    </div>
    <div class="ema-sakura" aria-hidden="true">{petals.map((style) => <span style={style}><i></i></span>)}</div>
    <script>
      import { registerThemeRuntime } from "@/core/themes/runtime.mjs";
      import { mountEma } from "../lib/runtime.mjs";
      registerThemeRuntime("ema", mountEma);
    </script>
  </body>
</html>
