---
import "@/core/styles/scale.css";
import "@/themes/blank/styles/theme.css";
import "@fontsource/gloock/latin-400.css";
import "../styles/theme.css";
import { Icon } from "astro-icon/components";
import { site } from "@/lib/site";
import { getI18n, localizePath, locales, type Locale } from "@/core/i18n";
import { getThemePath, stripTheme } from "@/core/themes/registry";
import ThemePreference from "@/core/themes/ThemePreference.astro";
import ThemeSwitcher from "@/core/themes/ThemeSwitcher.astro";
import LanguagePreference from "@/core/i18n/LanguagePreference.astro";
import LanguageSwitcher from "@/core/i18n/LanguageSwitcher.astro";
import ColorModePreference from "@/core/preferences/ColorModePreference.astro";
import SiteIcons from "@/core/components/SiteIcons.astro";
import SiteAttribution from "@/core/components/SiteAttribution.astro";
import SocialLinks from "@/core/components/SocialLinks.astro";
import SiteNavigation from "@/core/navigation/SiteNavigation.astro";
import { pageTransition } from "@/core/navigation/animations.mjs";
const { locale, t } = getI18n(Astro.url.pathname);
const href = (path: string) => getThemePath("ema", path, locale);
const path = stripTheme(Astro.url.pathname);
// `cursorRing` (Home and Games) adds the cursor ring's switch to the console; the ring runs only where it is rendered.
const { title: pageTitle = site.name, description = t("site.description"), isArticlePage = false, article, home = false, cursorRing = false } = Astro.props;
// Sakura Archive carries its own name; shared pages still pass the shared site name.
const brand = t("ema.brand");
const title = pageTitle.replaceAll(site.name, brand);
const [brandHead, ...brandTail] = brand.split(" ");
const canonical = Astro.site ? new URL(localizePath(Astro.url.pathname, locale), Astro.site) : undefined;
// Deterministic petal paths so every page and locale renders the same markup.
const petals = Array.from({ length: 16 }, (_, index) => `--petal-left:${(3 + index * 6.2).toFixed(1)}%;--petal-size:${9 + (index * 5) % 7}px;--petal-duration:${17 + (index * 7) % 13}s;--petal-delay:${-2 - (index * 11) % 29}s;--petal-drift:${[-72, 96, 40][index % 3]}px`);
---
<!doctype html>
<html lang={locale} data-theme="ema" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <LanguagePreference /><ThemePreference /><SiteIcons />
    <ColorModePreference lightColor="#fbf7ef" darkColor="#201f28" />
    <title>{title}</title><meta name="description" content={description} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content={isArticlePage ? "article" : "website"} />
    <meta property="og:locale" content={{ "zh-CN": "zh_CN", "zh-TW": "zh_TW", ja: "ja_JP", en: "en_US" }[locale]} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    {Astro.site && locales.map((language: Locale) => <link rel="alternate" hreflang={language} href={new URL(localizePath(Astro.url.pathname, language), Astro.site)} />)}
    {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
    <SiteNavigation />
  </head>
  <body data-blank data-ema data-ema-home={home ? "" : undefined}>
    <div class="ema-backdrop" aria-hidden="true"></div>
    <a class="blank-skip-link" href="#ema-main">{t("a11y.skip")}</a>
    <header class="ema-header" data-header data-site-header transition:name="site-header" transition:animate="none">
      <a class="ema-wordmark" href={href("/")} aria-label={`${brand} ${t("a11y.home")}`}><strong><span>{brandHead.split(/(\.)/).map((part) => part === "." ? <i>.</i> : part)}</span> <span>{brandTail.join(" ")}</span></strong><small>EMA / 02</small></a>
      <nav class="ema-nav" aria-label={t("a11y.navigation")}>{site.nav.map(item => <a href={href(item.href)} aria-current={(item.href === "/" ? path === "/" : path.startsWith(item.href)) ? "page" : undefined}>{t(`nav.${item.key}`)}</a>)}</nav>
      <div class="ema-header-actions">
        <LanguageSwitcher />
        <button class="ema-icon-button" type="button" data-color-mode-toggle hidden aria-label={t("mode.label")} aria-pressed="false" title={t("mode.toDark")} data-label-dark={t("mode.toDark")} data-label-light={t("mode.toLight")}><span class="blank-mode-moon"><Icon name="tabler:moon" size={18} /></span><span class="blank-mode-sun"><Icon name="tabler:sun" size={18} /></span></button>
        <button class="ema-motion-toggle" type="button" data-motion-toggle data-motion-pause={t("ema.motion.pause")} data-motion-resume={t("ema.motion.resume")} data-motion-reduced={t("ema.motion.reduced")} hidden aria-pressed="false" aria-label={t("ema.motion.pause")} title={t("ema.motion.pause")}><Icon name="tabler:player-pause" size={18} data-motion-pause-icon aria-hidden="true" /><Icon name="tabler:player-play" size={18} data-motion-play-icon aria-hidden="true" hidden /></button>
        <div class="ema-theme-docked"><ThemeSwitcher floating /></div>
      </div>
      {isArticlePage && <div class="blank-reading-track" aria-hidden="true"><span data-site-progress></span></div>}
    </header>
    <main id="ema-main" class:list={[{ "ema-content blank-main": !home, "ema-home-main": home, "blank-main--article": isArticlePage }]} tabindex="-1" transition:name="site-content" transition:animate={pageTransition}><slot /></main>
    <footer class="ema-footer">
      <a class="ema-footer-brand" href={href("/")}>{brand.split(/(\.)/).map((part) => part === "." ? <span>.</span> : part)}</a>
      <p>{t("home.statement2")}</p>
      <SocialLinks class="ema-social-links" />
      <div class="ema-footer-bottom"><SiteAttribution /><a href={href("/credits/")}>{t("footer.credits")}</a><button class="ema-console-dock" type="button" data-console-toggle aria-expanded="false" aria-controls="ema-console-panel" hidden><Icon name="tabler:music" size={14} aria-hidden="true" />{t("ema.console.tab")}</button><a href="#ema-main">{t("footer.top")} ↑</a></div>
    </footer>
    <div class="ema-theme-floating"><ThemeSwitcher floating /></div>
    <div class="ema-console" data-ema-console>
      <button class="console-tab" type="button" data-console-toggle aria-expanded="false" aria-controls="ema-console-panel" hidden><Icon name="tabler:music" size={16} aria-hidden="true" /><span>{t("ema.console.tab")}</span></button>
      <section class="console-panel" id="ema-console-panel" data-console-panel aria-label={t("ema.console.label")} hidden>
        <div class="console-head"><p>{t("ema.console.label")}</p><button type="button" data-console-close aria-label={t("ema.console.close")} title={t("ema.console.close")}><Icon name="tabler:x" size={15} /></button></div>
        <div class="console-card radio" data-radio data-tracks={JSON.stringify([1, 2, 3].map((index) => t(`ema.radio.track${index}`)))}>
          <div class="radio-head"><span class="radio-disc" aria-hidden="true"></span><div><p class="console-kicker">{t("ema.radio.label")}</p><strong data-radio-title>{t("ema.radio.track1")}</strong><small data-radio-count>1 / 3</small></div></div>
          <div class="radio-progress" aria-hidden="true"><span data-radio-progress></span></div>
          <div class="radio-time" aria-hidden="true"><span data-radio-elapsed>00:00</span><span data-radio-length>00:00</span></div>
          <div class="radio-controls">
            <button type="button" data-radio-prev aria-label={t("ema.radio.previous")} title={t("ema.radio.previous")}><Icon name="tabler:player-skip-back" size={17} /></button>
            <button class="radio-play" type="button" data-radio-play aria-pressed="false" aria-label={t("ema.radio.play")} title={t("ema.radio.play")} data-play={t("ema.radio.play")} data-pause={t("ema.radio.pause")}><Icon name="tabler:player-play" size={20} data-radio-play-icon /><Icon name="tabler:player-pause" size={20} data-radio-pause-icon hidden /></button>
            <button type="button" data-radio-next aria-label={t("ema.radio.next")} title={t("ema.radio.next")}><Icon name="tabler:player-skip-forward" size={17} /></button>
          </div>
          <label class="radio-volume"><Icon name="tabler:volume" size={16} aria-hidden="true" /><span class="blank-sr-only">{t("ema.radio.volume")}</span><input type="range" min="0" max="100" value="60" data-radio-volume /></label>
          <p class="radio-note">{t("ema.radio.note")}</p>
          <p class="radio-note" data-radio-unsupported hidden>{t("ema.radio.unsupported")}</p>
        </div>
        {cursorRing && (
          <div class="console-card ring-card" data-ring-card hidden>
            <button class="ring-switch" type="button" role="switch" aria-checked="true" aria-describedby="ema-ring-note ema-ring-status" data-ring-toggle><span>{t("ema.ring.label")}</span><span class="ring-switch-state" aria-hidden="true"><span data-ring-state data-on={t("ema.ring.on")} data-off={t("ema.ring.off")}>{t("ema.ring.on")}</span><span class="ring-switch-track"></span></span></button>
            <p class="radio-note" id="ema-ring-note">{t("ema.ring.note")}</p>
            <p class="radio-note" id="ema-ring-status" data-ring-status data-paused={t("ema.ring.paused")} data-reduced={t("ema.ring.reduced")} hidden></p>
          </div>
        )}
      </section>
    </div>
    <div class="ema-sakura" aria-hidden="true">{petals.map((style) => <span style={style}><i></i></span>)}</div>
    <script>
      import { registerThemeRuntime } from "@/core/themes/runtime.mjs";
      import { mountEma } from "../lib/runtime.mjs";
      registerThemeRuntime("ema", mountEma);
    </script>
  </body>
</html>
