---
// Sakura Archive's About page. As in the reference, the opening is the page head: the
// owner's name is the h1 and there is no separate "About." heading. Laid out after Yuimi-chaya's Fuyukawa Kagari About page
// (MIT License): an opening with the owner beside a page of text, a bookmark index,
// the tech line with its side notes, a shelf of stories, then characters beside the
// game archive. The reference's manga art is not used; the page beside the owner is
// the existing text-only letter. Everything shown comes from the shared profile data.
import { Icon } from "astro-icon/components";
import { getSiteContent } from "@/core/i18n/content";
import { getThemedI18n as getI18n } from "@/core/themes/i18n";
import { socialLinks } from "@/core/data/social";
import { keepTails } from "@/core/i18n/wrap.mjs";
import { site } from "@/lib/site";
import PageLayout from "@/core/themes/PageLayout.astro";
import { AVATAR_MONOGRAM, avatarAttributes } from "../lib/avatar.mjs";
import "../styles/shelf.css";
import "../styles/about.css";

const { locale, t, href } = getI18n(Astro.url.pathname);
const { animeFavorites, animeListUrl, currentSignals, favoriteGames, gameShelf, profileIdentity, profileStatus, profileTech, xpFavorites } = getSiteContent(locale);
const number = (index: number) => String(index + 1).padStart(2, "0");
const techIcons: Record<string, string> = {
  unity: "tabler:brand-unity", blender: "tabler:brand-blender", unreal: "unreal-engine",
  godot: "godot-engine", rpgmaker: "tabler:sword", vscode: "tabler:brand-vscode",
};
const techTones: Record<string, string> = { unity: "blue", blender: "orange", unreal: "slate", godot: "blue", rpgmaker: "pink", vscode: "green" };
// Section order follows the reference: tech (with now as its side note), stories, characters, games.
const marks = [
  { id: "tech", icon: "tabler:code" },
  { id: "animes", icon: "tabler:movie" },
  { id: "characters", icon: "tabler:heart" },
  { id: "games", icon: "tabler:device-gamepad" },
  { id: "now", icon: "tabler:flower" },
];
const socialIcons: Record<string, string> = { github: "tabler:brand-github", steam: "tabler:brand-steam" };
// A favourite game shows its shelf art (same key) when the shelf has one, else its icon.
const games = favoriteGames.map((game) => ({ ...game, art: gameShelf.find((entry) => entry.key === game.key)?.art }));
---
<PageLayout title={`About | ${site.name}`} description={t("about.description")}>
  <div class="ema-about ema-shelf">
    <header class="about-opening">
      <section class="about-owner" aria-label={t("ema.about.profile")}>
        <p class="about-eyebrow"><span>04 / {t("common.about")}</span><span>{t("ema.about.kicker")}</span></p>
        <div class="about-identity">
          <div class="about-avatar">
            <span class="about-tape" aria-hidden="true"></span>
            <span class="about-avatar-mark" {...avatarAttributes(profileIdentity.displayName)}>{AVATAR_MONOGRAM}</span>
          </div>
          <div>
            <h1>{profileIdentity.displayName}</h1>
            <p class="about-handle"><i lang="en">About</i><span aria-hidden="true"> / </span>{t("ema.brand")}</p>
          </div>
        </div>
        <p class="about-bio">{keepTails(profileIdentity.bio)}</p>
        <ul class="about-links">
          {socialLinks.map((social) => <li><a href={social.href} target="_blank" rel="me noopener noreferrer" aria-label={t(`social.${social.key}`)}><Icon name={socialIcons[social.key] ?? "tabler:link"} size={18} aria-hidden="true" /><span>{social.label}</span><Icon name="tabler:external-link" size={14} aria-hidden="true" /></a></li>)}
        </ul>
        <ul class="about-status" aria-label={t("ema.about.status")}>
          {profileStatus.map((item) => <li><Icon name="tabler:pin" size={14} aria-hidden="true" /><span>{item}</span></li>)}
        </ul>
      </section>
      <section class="about-letter" aria-labelledby="ema-about-letter">
        <span class="about-blossom" aria-hidden="true"></span>
        <p class="shelf-kicker">{t("ema.about.letterKicker")}</p>
        <h2 id="ema-about-letter">{t("ema.about.letterTitle")}</h2>
        <p>{t("ema.about.letterBody")}</p>
        <p class="about-signature">— {profileIdentity.displayName}</p>
      </section>
    </header>

    <nav class="about-marks" aria-label={t("ema.about.bookmarks")}>
      {marks.map((mark) => <a href={`#ema-about-${mark.id}`}><Icon name={mark.icon} size={17} aria-hidden="true" /><span>{t(`ema.about.${mark.id}Mark`)}</span></a>)}
    </nav>

    <section class="about-section" aria-labelledby="ema-about-tech">
      <div class="about-heading"><div><p class="shelf-kicker"><span>01</span>{t("ema.about.techKicker")}</p><h2 id="ema-about-tech">{t("ema.about.techTitle")}</h2></div></div>
      <div class="about-workbench">
        <ul class="about-tech">
          {profileTech.map((item) => <li class={`tone-${techTones[item.key]}`}><span class="about-tech-icon" aria-hidden="true"><Icon name={techIcons[item.key]} size={28} /></span><div><h3>{item.name}</h3><p>{item.note}</p></div></li>)}
        </ul>
        <aside class="about-now" aria-labelledby="ema-about-now">
          <h3 id="ema-about-now"><Icon name="tabler:flower" size={19} aria-hidden="true" />{t("about.now")}</h3>
          <dl>{currentSignals.map((item) => <div><dt>{item.label}</dt><dd>{keepTails(item.text)}</dd></div>)}</dl>
        </aside>
      </div>
    </section>

    <section class="about-section" aria-labelledby="ema-about-animes">
      <div class="about-heading">
        <div><p class="shelf-kicker"><span>02</span>{t("ema.about.animesKicker")}</p><h2 id="ema-about-animes">{t("ema.about.animesTitle")}</h2></div>
        <a class="about-more" href={animeListUrl} target="_blank" rel="noopener noreferrer">{t("about.animesNotion")}<Icon name="tabler:arrow-up-right" size={16} aria-hidden="true" /></a>
      </div>
      <ol class="about-animes">
        {animeFavorites.map((item, index) => (
          <li>
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              <span class="about-poster"><img src={item.cover} alt="" width="300" height="450" loading="lazy" decoding="async" /></span>
              <span class="about-caption"><span class="about-no" aria-hidden="true">{number(index)}</span><span><h3>{item.title}<Icon name="tabler:external-link" size={13} aria-hidden="true" /></h3><small>{item.subtitle}</small></span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="about-interests">
      <section class="about-section" aria-labelledby="ema-about-characters" data-site-disclosure data-limit="6">
        <div class="about-heading"><div><p class="shelf-kicker"><span>03</span>{t("ema.about.charactersKicker")}</p><h2 id="ema-about-characters">{t("ema.about.charactersTitle")}</h2></div></div>
        <ul class="about-characters" id="ema-character-list">
          {xpFavorites.map((item) => (
            <li data-site-disclosure-item>
              {item.portrait
                ? <img class="about-portrait" src={item.portrait} alt="" width="320" height="320" loading="lazy" decoding="async" />
                : <span class="about-portrait about-portrait-empty" aria-hidden="true"></span>}
              <h3>{item.title}</h3><p>{item.subtitle}</p>
            </li>
          ))}
        </ul>
        {xpFavorites.length > 6 && <button class="about-more about-character-toggle" type="button" data-site-disclosure-toggle data-label-more={t("about.charactersMore")} data-label-less={t("about.charactersLess")} aria-expanded="false" aria-controls="ema-character-list" hidden><span data-site-disclosure-label>{t("about.charactersMore")}</span><Icon name="tabler:chevron-down" size={16} aria-hidden="true" /></button>}
      </section>

      <section class="about-section" aria-labelledby="ema-about-games">
        <div class="about-heading"><div><p class="shelf-kicker"><span>04</span>{t("ema.about.gamesKicker")}</p><h2 id="ema-about-games">{t("ema.about.gamesTitle")}</h2></div></div>
        <ol class="about-games">
          {games.map((item) => (
            <li>
              {item.art
                ? <img class="about-game-art" src={item.art.src} alt="" width="1239" height="400" style={`object-position:${item.art.focus}`} loading="lazy" decoding="async" />
                : item.icon
                  ? <img class="about-game-art about-game-icon" src={item.icon} alt="" width="86" height="86" loading="lazy" decoding="async" />
                  : <span class="about-game-art" aria-hidden="true"></span>}
              <div>
                <h3>{item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{keepTails(item.title)}<Icon name="tabler:external-link" size={13} aria-hidden="true" /></a> : keepTails(item.title)}</h3>
                <p>{item.subtitle}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="about-more" href={href("/games/")}>{t("ema.about.gamesAll").replace("{n}", String(gameShelf.length))}<Icon name="tabler:arrow-right" size={16} aria-hidden="true" /></a>
      </section>
    </div>
  </div>
</PageLayout>
