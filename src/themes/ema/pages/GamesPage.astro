---
// Sakura Archive's Games page, laid out after the playroom of Yuimi-chaya's Fuyukawa Kagari theme
// (MIT License): an opening with a CJK title and a Latin subtitle, a dashed ticket line, then one
// "cabinet" per game: a numbered label strip, a screen with the game's art, the copy and one filled
// action. The reference's manga art and its playable mini-games are not used; the cabinets hold the
// shared game shelf, filtered through the shared data-site-* hooks. Every string already existed.
import { Icon } from "astro-icon/components";
import { getSiteContent } from "@/core/i18n/content";
import { getThemedI18n as getI18n } from "@/core/themes/i18n";
import { gameGenres } from "@/core/content/select-games.mjs";
import { keepTails } from "@/core/i18n/wrap.mjs";
import { site } from "@/lib/site";
import PageLayout from "@/core/themes/PageLayout.astro";
import "../styles/shelf.css";
import "../styles/games.css";

const { locale, t, unit } = getI18n(Astro.url.pathname);
const { favoriteGames, gameShelf } = getSiteContent(locale);
// The About page's favorites carry a badge here.
const favorites = new Set<string>(favoriteGames.map((game) => game.key));
const genreTone: Record<string, string> = { story: "lavender", action: "blue", strategy: "green", rhythm: "pink", online: "yellow" };
const genreIcon: Record<string, string> = { story: "tabler:book-2", action: "tabler:sword", strategy: "tabler:chess", rhythm: "tabler:music", online: "tabler:world" };
const genres = gameGenres.filter((genre) => gameShelf.some((game) => game.genre === genre));
const total = gameShelf.length;
const pad = (value: number) => String(value).padStart(2, "0");
const linkLabel = (game: (typeof gameShelf)[number]) => (game.link?.steam ? "Steam" : t("games.official"));
---
<PageLayout title={`${t("nav.games")} | ${site.name}`} description={t("games.description")} cursorRing={true}>
  <header class="games-opening">
    <div>
      <p class="games-eyebrow">03 / {t("nav.games")}</p>
      <h1>{t("games.label")}{locale !== "en" && <span class="games-sub" lang="en">Games</span>}</h1>
      <p class="games-intro">{keepTails(t("games.intro"))}</p>
    </div>
    <p class="games-total"><strong>{pad(total)}</strong><span>{unit("common.games", total)}</span></p>
  </header>
  <section class="ema-games ema-shelf" data-site-collection data-unit={t("common.games")} data-unit-one={t("common.gamesOne")} aria-label={t("games.collection")}>
    <div class="games-tools">
      <form class="games-filters" data-site-filter-form hidden>
        <fieldset>
          <legend class="blank-sr-only">{t("games.genres")}</legend>
          <button type="button" data-site-category="all" aria-pressed="true"><Icon class="games-check" name="tabler:check" size={15} aria-hidden="true" /><Icon class="games-genre-icon" name="tabler:layout-grid" size={15} aria-hidden="true" />{t("games.all")}<span>{total}</span></button>
          {genres.map((genre) => <button class={`tone-${genreTone[genre]}`} type="button" data-site-category={genre} aria-pressed="false"><Icon class="games-check" name="tabler:check" size={15} aria-hidden="true" /><Icon class="games-genre-icon" name={genreIcon[genre]} size={15} aria-hidden="true" />{t(`games.genre.${genre}`)}<span>{gameShelf.filter((game) => game.genre === genre).length}</span></button>)}
        </fieldset>
      </form>
      <output class="games-count" data-site-count aria-live="polite" aria-atomic="true">{total} {unit("common.games", total)}</output>
    </div>
    <ol class="games-grid" data-site-entries>
      {gameShelf.map((game) => (
        <li class:list={["game-cabinet", `tone-${genreTone[game.genre]}`, { "is-favorite": favorites.has(game.key) }]} data-site-entry data-category={game.genre} data-search={`${game.name} ${game.title}`}>
          <p class="game-label" aria-hidden="true"><span>GAME / {pad(game.number)}</span><Icon name={genreIcon[game.genre]} size={18} /></p>
          <div class:list={["game-screen", { "has-art": game.art }]} aria-hidden="true">
            {game.art
              ? <img src={game.art.src} alt="" loading="lazy" decoding="async" style={`object-position:${game.art.focus}`} />
              : <span>{game.title}</span>}
          </div>
          <div class="game-copy">
            <p class="game-meta">
              <span class="game-genre">{t(`games.genre.${game.genre}`)}</span>
              {favorites.has(game.key) && <span class="game-favorite"><Icon name="tabler:heart-filled" size={11} aria-hidden="true" />{t("games.favorite")}</span>}
              {game.status && <span class="game-status">{t(`games.status.${game.status}`)}</span>}
            </p>
            <h2>{keepTails(game.name)}</h2>
            {game.name !== game.title && <p class="game-title">{game.title}</p>}
            {game.pick && <p class="game-pick" role="img" aria-label={t("games.pick").replace("{n}", String(game.pick))}>{[1, 2, 3].map((step) => <span class:list={{ "is-on": step <= (game.pick ?? 0) }}></span>)}</p>}
            {game.note && !game.note.translated && <p class="game-untranslated">{t("games.untranslated")}</p>}
            {game.note && <p class="game-note" lang={game.note.lang}>{keepTails(game.note.text)}</p>}
            {game.link && <p class="game-actions"><a class="game-play" href={game.link.href} target="_blank" rel="noopener noreferrer" aria-label={t("games.opens").replace("{name}", game.name).replace("{site}", linkLabel(game))}><Icon name={game.link.steam ? "tabler:brand-steam" : "tabler:world"} size={17} aria-hidden="true" />{linkLabel(game)}<Icon name="tabler:arrow-up-right" size={15} aria-hidden="true" /></a></p>}
          </div>
        </li>
      ))}
    </ol>
    <p class="games-more">{t("games.more")}</p>
  </section>
</PageLayout>
