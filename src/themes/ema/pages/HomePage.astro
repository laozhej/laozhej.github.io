---
import { getSiteContent } from "@/core/i18n/content";
import { getI18n } from "@/core/i18n";
import { getPublishedPosts } from "@/core/content/blog";
import { socialLinks } from "@/core/data/social";
import { getThemePath } from "@/core/themes/registry";
import { site } from "@/lib/site";
import EmaLayout from "../layouts/EmaLayout.astro";
import "../styles/home.css";

const { locale, t, formatDate, categoryLabel } = getI18n(Astro.url.pathname);
const href = (path: string) => getThemePath("ema", path, locale);
const { profileIdentity, profileTech, favoriteGames, xpFavorites, projectTechLines } = getSiteContent(locale);
const posts = (await getPublishedPosts(locale)).slice(0, 3);
const commands = ["journal", "collection", "about", "echo"].map((id) => t(`ema.command.${id}`));
const noticeTips = Array.from({ length: 7 }, (_, index) => t(`ema.notice.tip${index + 1}`));
// Everything that rains down comes from the shared profile, collection and social data.
const tags = [...new Set([
  ...favoriteGames.map((item) => item.title),
  ...xpFavorites.map((item) => item.title),
  ...profileTech.map((item) => item.name),
  ...projectTechLines.map((item) => item.label),
  ...Object.values(categoryLabel),
  ...socialLinks.map((item) => item.label),
])];
const asset = (name: string) => `/themes/ema/assets/${name}.webp`;
const panels = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m"];
---

<EmaLayout title={`${site.name} | ${t("home.title")}`} description={t("ema.description")} home={true}>
  <div id="ema-home">
    <div class="hero-scroll-scene" data-hero-scene>
    <section class="hero" id="ema-top" data-hero aria-label={t("ema.hero.label")}>
      <div class="manga-wall" data-parallax-layer="back" aria-hidden="true">
        <div class="manga-grid">{panels.map((panel) => <i class={`panel panel-${panel}`}></i>)}</div>
      </div>
      <div class="focus-lines" aria-hidden="true"></div>
      <div class="hero-art" data-parallax-layer="front"><img class="ema" src={asset("ema")} alt={t("ema.art.ema")} width="905" height="2400" fetchpriority="high" /></div>
      <div class="hero-veil" aria-hidden="true"></div>
      <button class="notice-trigger" type="button" data-notice-open aria-haspopup="dialog" aria-controls="ema-notice" hidden><span aria-hidden="true">✿</span>{t("ema.notice.open")}</button>
      <div class="hero-column">
        <div class="hero-copy" data-hero-copy>
          <p class="eyebrow"><span>{t("theme.ema")}</span>{t("ema.hero.subtitle")}</p>
          <h1 class="hero-title" data-text={site.name}><span>{site.name}</span><em aria-hidden="true">.</em></h1>
          <p class="hero-diary">{t("ema.hero.diary")}</p>
          <p class="terminal-line" aria-hidden="true"><span class="terminal-prompt">ema@archive:~$</span><code data-typed data-commands={JSON.stringify(commands)}>{commands[0]}</code><span class="caret"></span></p>
          <p class="sr-only">{t("ema.command.accessible")}</p>
        </div>
        <section class="identity" data-identity aria-label={t("ema.profile.label")}>
          <div class="identity-avatar">
            <button class="avatar-button" type="button" data-avatar-button aria-label={t("ema.profile.hello")} data-message={t("ema.profile.message")} data-too-fast={t("ema.profile.tooFast")}>
              <span class="avatar-face" aria-hidden="true"></span>
              <span class="avatar-flower" aria-hidden="true"></span>
            </button>
            <span class="avatar-bubble" role="status" data-avatar-message hidden></span>
          </div>
          <div class="identity-terminal">
            <div class="identity-bar" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>blank-space.profile</span></div>
            <p class="identity-path" aria-hidden="true">~/blank-space/profile</p>
            <p class="identity-command"><span class="terminal-prompt" aria-hidden="true">profile@blank:~$</span><strong data-name-typed data-names={JSON.stringify([profileIdentity.displayName, site.name])}>{profileIdentity.displayName}</strong><span class="caret" aria-hidden="true"></span></p>
            <p class="identity-bio">{profileIdentity.bio}</p>
            <div class="identity-links">{socialLinks.map((social) => <a href={social.href} target="_blank" rel="me noopener noreferrer" aria-label={t(`social.${social.key}`)}>{social.label} <span aria-hidden="true">↗</span></a>)}<a href={href("/about/")}>{t("common.about")} <span aria-hidden="true">→</span></a></div>
          </div>
        </section>
      </div>
      <a class="scroll-cue" href="#ema-chapters"><span class="terminal-prompt" aria-hidden="true">scroll@archive:~$</span><span>{t("ema.hero.down")}</span><b aria-hidden="true"><i>&gt;</i><i>&gt;</i><i>&gt;</i></b></a>
    </section>
    </div>

    <dialog class="ema-notice" id="ema-notice" data-notice aria-labelledby="ema-notice-title" data-title={t("ema.notice.title")} data-tips={JSON.stringify(noticeTips)}>
      <form method="dialog" class="notice-card">
        <button class="notice-close" type="submit" aria-label={t("ema.notice.close")}><span aria-hidden="true">×</span></button>
        <div class="notice-head">
          <span class="notice-icon" aria-hidden="true">✿</span>
          <div><p data-notice-date>{t("ema.notice.open")}</p><h2 id="ema-notice-title" data-notice-title>{t("ema.notice.open")}</h2></div>
        </div>
        <div class="notice-body">
          <p class="notice-tip" data-notice-tip>{noticeTips[0]}</p>
          <p class="notice-line">{t("ema.note.line1")}{t("ema.note.line2")}</p>
          <small>— {t("ema.note.signature")}</small>
        </div>
        <label class="notice-skip"><input type="checkbox" data-notice-skip /><span>{t("ema.notice.skip")}</span></label>
      </form>
    </dialog>

    <section class="chapters" id="ema-chapters" aria-labelledby="ema-chapters-title">
      <div class="section-heading" data-ema-reveal><div><p class="eyebrow">{t("ema.chapters.kicker")}</p><h2 id="ema-chapters-title">{t("ema.chapters.title")}<span aria-hidden="true">.</span></h2></div><p>{t("ema.chapters.intro")}</p></div>
      <div class="chapter-rail" data-rail>
        <div class="rail-stage" data-rail-stage>
          <div class="rail-topline"><span>{t("ema.chapters.browse")}</span><div class="rail-controls"><span data-rail-position aria-live="polite">01 / 03</span><button type="button" data-rail-prev aria-label={t("ema.chapters.previous")} disabled>←</button><button type="button" data-rail-next aria-label={t("ema.chapters.next")}>→</button></div></div>
          <div class="rail-progress" aria-hidden="true"><span data-rail-progress></span></div>
          <div class="rail-viewport"><div class="rail-track" data-rail-track tabindex="0" role="region" aria-label={t("ema.chapters.label")}>
            <article class="chapter-card chapter-journal" data-chapter data-ema-reveal>
              <div class="chapter-visual notebook-art" aria-hidden="true"><div class="notebook"><span>{t("ema.journal.art")}</span><i></i><i></i><i></i></div><div class="pencil"></div><span class="pressed-flower">✳</span></div>
              <div class="chapter-copy"><span class="chapter-number" aria-hidden="true">01</span><p class="eyebrow">{t("ema.journal.kicker")}</p><h3>{t("ema.journal.title")}</h3><p>{t("ema.journal.intro")}</p><a href={href("/blog/")}>{t("ema.journal.open")} <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="chapter-card chapter-collection" data-chapter data-ema-reveal>
              <div class="chapter-visual sea-art" aria-hidden="true"><img src={asset("shiroha")} alt="" width="1138" height="1600" loading="lazy" /><span class="sea-label">{t("ema.collection.art")}</span></div>
              <div class="chapter-copy"><span class="chapter-number" aria-hidden="true">02</span><p class="eyebrow">{t("ema.collection.kicker")}</p><h3>{t("ema.collection.title")}</h3><p>{t("ema.collection.intro")}</p><a href={href("/games/")}>{t("ema.collection.open")} <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="chapter-card chapter-about" data-chapter data-ema-reveal>
              <div class="chapter-visual letter-art" aria-hidden="true"><div class="envelope"></div><div class="letter">{t("ema.about.art1")}<br /><span>{t("ema.about.art2")}</span></div><span class="stamp">{site.name.charAt(0)}.</span></div>
              <div class="chapter-copy"><span class="chapter-number" aria-hidden="true">03</span><p class="eyebrow">{t("ema.about.kicker")}</p><h3>{t("ema.about.title")}</h3><p>{t("ema.about.intro")}</p><a href={href("/about/")}>{t("ema.about.open")} <span aria-hidden="true">↗</span></a></div>
            </article>
          </div></div>
        </div>
      </div>
    </section>

    <section class="signal-scene" data-signal aria-label={t("ema.signal.label")}>
      <div class="signal-backdrop" aria-hidden="true"></div>
      <div class="signal-word" aria-hidden="true"><span>{site.name}</span><small>{t("ema.signal.motto")}</small></div>
      <div class="signal-card" role="group" aria-label={t("ema.signal.clock")}>
        <p data-clock-date>&nbsp;</p>
        <strong data-clock-time>--:--:--</strong>
        <span data-clock-zone data-label={t("ema.signal.zone")}>{t("ema.signal.zone")}</span>
      </div>
      <div class="welcome-bubble">
        <span class="quote-mark" aria-hidden="true">“</span>
        <h2>{t("ema.signal.welcome")}</h2>
        <p>{t("ema.signal.welcomeText")}</p>
        <a href={href("/games/")}>{t("ema.favorites.open")} <span aria-hidden="true">↗</span></a>
        <span class="quote-mark quote-end" aria-hidden="true">”</span>
      </div>
      <ul class="tag-rain" data-tag-rain aria-label={t("ema.signal.tags")}>
        {tags.map((tag) => <li data-tag>{tag}</li>)}
      </ul>
    </section>

    <section class="reading-section" aria-labelledby="ema-reading-title">
      <div class="reading-intro" data-ema-reveal><p class="eyebrow">{t("ema.recent.kicker")}</p><h2 id="ema-reading-title">{t("ema.recent.title")}<span aria-hidden="true">.</span></h2><p>{t("ema.recent.intro")}</p><a href={href("/blog/")}>{t("common.allArticles")} <span aria-hidden="true">↗</span></a></div>
      <div class="article-list" data-ema-reveal>{posts.map((post, index) => {
        const date = post.data.updatedDate ?? post.data.pubDate;
        return <a href={href(`/blog/${post.slug}/`)} data-ema-reveal-item><span class="article-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><small><time datetime={date.toISOString()}>{formatDate(date)}</time><span>{categoryLabel[post.data.category]}</span></small><h3 lang={post.data.locale}>{post.data.title}</h3>{post.data.locale !== locale && <p class="translation-fallback">{t("article.originalLanguage")}</p>}</div><span aria-hidden="true">↗</span></a>;
      })}{posts.length === 0 && <p>{t("home.empty")}</p>}</div>
    </section>
  </div>
</EmaLayout>
