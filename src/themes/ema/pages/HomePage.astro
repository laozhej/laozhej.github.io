---
import { getSiteContent } from "@/core/i18n/content";
import { getI18n } from "@/core/i18n";
import { getPublishedPosts } from "@/core/content/blog";
import { socialLinks } from "@/core/data/social";
import { getThemePath } from "@/core/themes/registry";
import { site } from "@/lib/site";
import EmaLayout from "../layouts/EmaLayout.astro";
import "../styles/home.css";

const { locale, t, formatDate, categoryLabel } = getI18n(Astro.url.pathname);
const href = (path: string) => getThemePath("ema", path, locale);
const { profileIdentity, favoriteGames, xpFavorites } = getSiteContent(locale);
const posts = (await getPublishedPosts(locale)).slice(0, 3);
const [titleFirst, ...titleRest] = site.name.split(/\s+/);
const favorites = [...favoriteGames, ...xpFavorites];
const commands = [
  { id: "journal", label: t("nav.blog") },
  { id: "collection", label: t("nav.games") },
  { id: "about", label: t("nav.about") }
];
const asset = (name: string) => `/themes/ema/assets/${name}.webp`;
---

<EmaLayout title={`${site.name} | ${t("home.title")}`} description={t("ema.description")} home={true}>
  <div id="ema-home" data-motion-pause={t("ema.motion.pause")} data-motion-resume={t("ema.motion.resume")} data-motion-reduced={t("ema.motion.reduced")}>
    <section class="hero" id="ema-top" data-hero aria-label={t("ema.hero.label")}>
      <div class="back-layer" data-parallax-layer="back" aria-hidden="true">
        <div class="paper-strip paper-strip-a"></div><div class="paper-strip paper-strip-b"></div>
        <figure class="ink-frame shiki-frame"><div class="shiki-crop"></div><figcaption>{t("ema.art.quiet")}</figcaption></figure>
        <figure class="ink-frame alice-frame"><div class="alice-crop"><img src={asset("alice")} alt="" width="750" height="1000" /></div><figcaption>{t("ema.art.pages")}</figcaption></figure>
        <span class="margin-note note-a">{t("ema.art.margin1")}</span><span class="margin-note note-b">{t("ema.art.margin2")}</span>
      </div>
      <div class="hero-art" data-parallax-layer="front"><img class="ema" src={asset("ema")} alt={t("ema.art.ema")} width="905" height="2400" fetchpriority="high" /></div>
      <div class="petals" data-petals aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="hero-copy">
        <p class="eyebrow">{t("ema.hero.kicker")}</p>
        <h1>{titleFirst}<br /><span>{titleRest.join(" ")}</span><em aria-hidden="true">.</em></h1>
        <p class="hero-subtitle">{t("ema.hero.subtitle")}</p>
        <section class="command-card" aria-label={t("ema.command.label")}>
          <div class="command-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span aria-hidden="true">blank-space.note</span><button type="button" data-profile-toggle aria-expanded="false" aria-controls="ema-profile-panel">{t("ema.profile.toggle")} <span aria-hidden="true">＋</span></button></div>
          <div class="command-line" aria-hidden="true"><span class="prefix">❀ ~</span><code data-typed>{t("ema.command.journal")}</code><span class="caret"></span></div>
          <p class="sr-only">{t("ema.command.accessible")}</p>
          <p class="command-result"><span aria-hidden="true">↳</span><span data-command-result>{t("ema.command.journalResult")}</span></p>
          <div class="command-actions" role="group" aria-label={t("ema.command.switch")}>
            {commands.map((command, index) => <button type="button" data-command={command.id} data-command-text={t(`ema.command.${command.id}`)} data-command-result={t(`ema.command.${command.id}Result`)} aria-pressed={index === 0 ? "true" : "false"}>{command.label}</button>)}
          </div>
          <div class="profile-panel" id="ema-profile-panel" data-profile-panel hidden>
            <div class="profile-row"><button class="avatar" type="button" data-avatar-button aria-label={t("ema.profile.hello")}>{site.name.charAt(0)}<span aria-hidden="true">.</span></button><div><strong>{profileIdentity.displayName}</strong><p>{profileIdentity.bio}</p></div><span class="avatar-message" role="status" data-avatar-message hidden>{t("ema.profile.message")}</span></div>
            <div class="profile-links">{socialLinks.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={t(`social.${social.key}`)}>{social.label} <span aria-hidden="true">↗</span></a>)}<a href={href("/about/")}>{t("common.about")} <span aria-hidden="true">↗</span></a></div>
            <div class="profile-hold" data-profile-hold hidden><p role="status">{t("ema.profile.hold")}</p><button type="button" data-profile-continue>{t("ema.profile.continue")} <span aria-hidden="true">↓</span></button><span class="profile-hold-progress" aria-hidden="true"></span></div>
          </div>
        </section>
      </div>
      <figure class="shiroha-polaroid"><span class="tape" aria-hidden="true"></span><div class="polaroid-photo"><img src={asset("shiroha")} alt={t("ema.art.shiroha")} width="1138" height="1600" /></div><figcaption>{t("ema.art.summer")} <span aria-hidden="true">✧</span></figcaption></figure>
      <aside class="hero-note"><button type="button" data-note-toggle aria-expanded="true" aria-controls="ema-today-note">{t("ema.note.title")} <span aria-hidden="true">−</span></button><div id="ema-today-note" data-note-panel><p>{t("ema.note.line1")}<br />{t("ema.note.line2")}</p><small>{t("ema.note.signature")}</small></div></aside>
      <a class="scroll-cue" href="#ema-chapters"><span>{t("ema.hero.down")}</span><b aria-hidden="true">↓</b></a><div class="paper-edge" aria-hidden="true"></div>
    </section>

    <section class="chapters" id="ema-chapters" aria-labelledby="ema-chapters-title">
      <div class="section-heading"><div><p class="eyebrow">{t("ema.chapters.kicker")}</p><h2 id="ema-chapters-title">{t("ema.chapters.title")}<span aria-hidden="true">.</span></h2></div><p>{t("ema.chapters.intro")}</p></div>
      <div class="chapter-rail" data-rail>
        <div class="rail-stage" data-rail-stage>
          <div class="rail-topline"><span>{t("ema.chapters.browse")}</span><div class="rail-controls"><span data-rail-position aria-live="polite">01 / 03</span><button type="button" data-rail-prev aria-label={t("ema.chapters.previous")} disabled>←</button><button type="button" data-rail-next aria-label={t("ema.chapters.next")}>→</button></div></div>
          <div class="rail-viewport"><div class="rail-track" data-rail-track tabindex="0" role="region" aria-label={t("ema.chapters.label")}>
            <article class="chapter-card chapter-journal" data-chapter>
              <div class="chapter-visual notebook-art" aria-hidden="true"><div class="notebook"><span>{t("ema.journal.art")}</span><i></i><i></i><i></i></div><div class="pencil"></div><span class="pressed-flower">✳</span></div>
              <div class="chapter-copy"><span class="chapter-number" aria-hidden="true">01</span><p class="eyebrow">{t("ema.journal.kicker")}</p><h3>{t("ema.journal.title")}</h3><p>{t("ema.journal.intro")}</p><a href={href("/blog/")}>{t("ema.journal.open")} <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="chapter-card chapter-collection" data-chapter>
              <div class="chapter-visual sea-art" aria-hidden="true"><img src={asset("shiroha")} alt="" width="1138" height="1600" loading="lazy" /><span class="sea-label">{t("ema.collection.art")}</span></div>
              <div class="chapter-copy"><span class="chapter-number" aria-hidden="true">02</span><p class="eyebrow">{t("ema.collection.kicker")}</p><h3>{t("ema.collection.title")}</h3><p>{t("ema.collection.intro")}</p><a href={href("/games/")}>{t("ema.collection.open")} <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="chapter-card chapter-about" data-chapter>
              <div class="chapter-visual letter-art" aria-hidden="true"><div class="envelope"></div><div class="letter">{t("ema.about.art1")}<br /><span>{t("ema.about.art2")}</span></div><span class="stamp">{site.name.charAt(0)}.</span></div>
              <div class="chapter-copy"><span class="chapter-number" aria-hidden="true">03</span><p class="eyebrow">{t("ema.about.kicker")}</p><h3>{t("ema.about.title")}</h3><p>{t("ema.about.intro")}</p><a href={href("/about/")}>{t("ema.about.open")} <span aria-hidden="true">↗</span></a></div>
            </article>
          </div></div>
        </div>
      </div>
    </section>
    <section class="reading-section" aria-labelledby="ema-reading-title">
      <div class="reading-intro"><p class="eyebrow">{t("ema.recent.kicker")}</p><h2 id="ema-reading-title">{t("ema.recent.title")}<span aria-hidden="true">.</span></h2><p>{t("ema.recent.intro")}</p><a href={href("/blog/")}>{t("common.allArticles")} <span aria-hidden="true">↗</span></a></div>
      <div class="article-list">{posts.map((post) => {
        const date = post.data.updatedDate ?? post.data.pubDate;
        return <a href={href(`/blog/${post.slug}/`)}><div><small><time datetime={date.toISOString()}>{formatDate(date)}</time><span>{categoryLabel[post.data.category]}</span></small><h3 lang={post.data.locale}>{post.data.title}</h3>{post.data.locale !== locale && <p class="translation-fallback">{t("article.originalLanguage")}</p>}</div><span aria-hidden="true">↗</span></a>;
      })}{posts.length === 0 && <p>{t("home.empty")}</p>}</div>
    </section>
    <section class="favorites-section" aria-labelledby="ema-favorites-title">
      <div><p class="eyebrow">{t("ema.favorites.kicker")}</p><h2 id="ema-favorites-title">{t("ema.favorites.title")}<span aria-hidden="true">.</span></h2><p>{t("ema.favorites.intro")}</p></div>
      <div class="tag-cloud" data-tag-cloud>{favorites.map((favorite) => <span data-tag>{favorite.title}</span>)}</div>
      <a class="favorites-note" href={href("/games/")}>{t("ema.favorites.open")} <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</EmaLayout>
