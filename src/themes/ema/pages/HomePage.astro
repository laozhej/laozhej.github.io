---
// Sakura Archive homepage, rebuilt on the layout and interactions of the reference's Fuyukawa Kagari
// home (Yuimi-chaya/Yuimi-chaya.github.io, MIT; mapping and deviations in docs/REFERENCE.md):
// 1. a viewport-high stage: a drawn storyboard behind, Ema as the full-height front layer, the
//    identity text on her left and her five-pose theatre on her right (below her on phones);
// 2. an identity card that rises and docks over the stage on a wheel pull (shown in the page flow on
//    touch screens and whenever motion is off);
// 3. a sticky chapter rail that walks sideways as the page scrolls;
// 4. a signal scene (local clock, today's Sakura note, falling tags) and recent writing.
// Ema's five images are restored unchanged from 76c9da5 at the owner's request (2026-11-14).
// Historical source records and unconfirmed permission status are in public/themes/ema/ASSETS.json.
import { Icon } from "astro-icon/components";
import { getSiteContent } from "@/core/i18n/content";
import { getI18n, localizePath } from "@/core/i18n";
import { getPublishedPosts } from "@/core/content/blog";
import { getNotes } from "@/core/content/notes";
import { formatNoteDay, noteNumber, pickNote, utcDay } from "@/core/content/select-notes.mjs";
import { socialLinks } from "@/core/data/social";
import { getThemePath } from "@/core/themes/registry";
import { keepTails } from "@/core/i18n/wrap.mjs";
import EmaLayout from "../layouts/EmaLayout.astro";
import Storyboard from "../components/Storyboard.astro";
import emaAssets from "../../../../public/themes/ema/ASSETS.json";
import { AVATAR_MONOGRAM, avatarAttributes } from "../lib/avatar.mjs";
import "../styles/stage.css";

const { locale, t, formatDate, categoryLabel } = getI18n(Astro.url.pathname);
const href = (path: string) => getThemePath("ema", path, locale);
const { profileIdentity, profileTech, favoriteGames, gameShelf, xpFavorites, projectEntries, projectTechLines, currentSignals } = getSiteContent(locale);
const project = projectEntries[0];
const posts = (await getPublishedPosts(locale)).slice(0, 3);
const notes = getNotes(locale);
const note = pickNote(notes, utcDay(new Date()));
const brand = t("ema.brand");
const pad = (value: number) => String(value).padStart(2, "0");
const brandParts = brand.split(/(\.)/);

// Ema's five poses keep their order and labels from ema-messages.
const poseKeys = ["smile", "wave", "together", "talk", "refute"] as const;
const poses = poseKeys.map((key) => {
  const asset = emaAssets.assets.find((asset) => asset.pose_key === `ema.frames.${key}`)!;
  return { key, label: t(`ema.frames.${key}`), src: `/themes/ema/${asset.file}`, dimensions: asset.dimensions };
});
const ema = xpFavorites.find((item) => item.key === "emma")?.title ?? "";
// The owner's avatar: the monogram 旭 in every locale, an image named after the owner.
const avatar = avatarAttributes(profileIdentity.displayName);

// The terminal line types the owner's own current signals (shared data), one after another.
const signals = currentSignals.map((item) => `${item.label} · ${item.text}`);

// The chapter rail: four pages of the archive, each previewed with shared data only.
const shortTitle = project ? project.title.split(" · ")[0] : "";
const projectLine = project ? projectTechLines.find((line) => line.key === project.line)?.label ?? "" : "";
const chapters = [
  { route: "/blog/", latin: "Journal", title: t("blog.label"), note: t("blog.intro"), plate: "journal" },
  { route: "/projects/", latin: "Works", title: t("projects.label"), note: t("projects.intro"), plate: "works" },
  { route: "/games/", latin: "Playroom", title: t("games.label"), note: t("games.intro"), plate: "games" },
  { route: "/about/", latin: "Profile", title: t("footer.about"), note: t("about.intro"), plate: "about" },
];

// Falling tags: tools, favourite games, the first characters and the site's own lines, de-duplicated.
const seen = new Set<string>();
const take = (items: readonly string[]) => items.filter((item) => !seen.has(item) && Boolean(seen.add(item)));
const tags = [
  ...take(profileTech.map((item) => item.name)),
  ...take(favoriteGames.map((item) => item.title)),
  ...take(xpFavorites.slice(0, 8).map((item) => item.title)),
  ...take([...projectTechLines.map((item) => item.label), ...Object.values(categoryLabel), ...socialLinks.map((item) => item.label)]),
];
const sitePath = localizePath(Astro.url.pathname, locale).replace(/\/$/, "") || "/";
---

<EmaLayout title={`${brand} | ${t("home.title")}`} description={t("ema.description")} home={true} cursorRing={true}>
  <div id="ema-stage" class="k" data-k-root>
    <div class="k-stage" data-k-stage>
      <section class="k-hero" data-k-hero>
        <div class="k-scene" aria-hidden="true">
          <div class="k-camera"><div class="k-back" data-k-back><Storyboard /><div class="k-light"></div></div></div>
        </div>
        <div class="k-veil" aria-hidden="true"></div>

        <figure class="k-ema" data-k-front aria-labelledby="ema-scene-label">
          <figcaption class="blank-sr-only" id="ema-scene-label">{t("ema.frames.label")}</figcaption>
          <div class="k-frames" data-ema-frames>
            {poses.map((pose, index) => (
              <img class="k-frame" data-ema-frame data-label={pose.label} data-active={String(index === 0)}
                src={index === 0 ? pose.src : undefined} data-src={pose.src}
                width={pose.dimensions[0]} height={pose.dimensions[1]}
                alt={index === 0 ? ema : ""} aria-hidden={index === 0 ? undefined : "true"}
                decoding="async" fetchpriority={index === 0 ? "high" : undefined} />
            ))}
            <button class="k-ema-hit" type="button" data-frame-hit aria-label={t("ema.frames.hint")} hidden></button>
          </div>
        </figure>

        <div class="k-copy" data-k-copy>
          <p class="k-eyebrow">{t("home.kicker")}</p>
          {/* The owner's name, with the alias in the wordmark face (the title the owner chose on 2026-11-13). */}
          <h1 class="k-title k-title--name" id="ema-title">{profileIdentity.displayName}<span class="k-title-alias"> / {profileIdentity.alias}</span></h1>
          <p class="k-diary">{keepTails(t("ema.home.diary"))}</p>
          {signals.length > 0 && (
            <p class="k-terminal" data-k-terminal data-lines={JSON.stringify(signals)}>
              <Icon name="tabler:flower" size={18} aria-hidden="true" />
              <span class="k-typing" data-k-typing aria-hidden="true">{signals[0]}</span>
              <span class="k-caret" aria-hidden="true"></span>
              <span class="blank-sr-only">{signals.join(" / ")}</span>
            </p>
          )}
        </div>

        <div class="k-theatre" data-frame-controls role="group" aria-label={t("ema.frames.label")} data-next={t("ema.frames.next")} data-restart={t("ema.frames.restart")} data-error={t("ema.frames.error")} hidden>
          <p class="k-kicker">{t("ema.frames.label")}</p>
          <output class="k-theatre-status" data-frame-status aria-live="polite" aria-atomic="true"><span class="k-theatre-no" data-frame-status-no>01 / {pad(poses.length)}</span><span class="k-theatre-pose" data-frame-status-label> · {poses[0].label}</span></output>
          <div class="k-theatre-buttons">
            <button type="button" data-frame-prev aria-label={t("ema.frames.previous")} title={t("ema.frames.previous")}><Icon name="tabler:chevron-left" size={18} aria-hidden="true" /></button>
            <button type="button" data-frame-next title={t("ema.frames.next")}><span class="blank-sr-only" data-frame-next-label>{t("ema.frames.next")}</span><Icon name="tabler:chevron-right" size={18} aria-hidden="true" /></button>
          </div>
          <p class="k-hint"><Icon name="tabler:hand-click" size={15} aria-hidden="true" />{keepTails(t("ema.frames.hint"))}</p>
        </div>

        {note && <button class="k-note-open" type="button" data-notice-open aria-haspopup="dialog" aria-controls="ema-notice" hidden><Icon name="tabler:note" size={17} aria-hidden="true" />{t("ema.notice.open")}</button>}

        <a class="k-cue" href="#k-contents" data-k-cue><span>{t("ema.home.cue")}</span><span class="k-cue-arrows" aria-hidden="true"><i>&gt;</i><i>&gt;</i><i>&gt;</i></span></a>
      </section>

      <section class="k-profile" data-k-profile aria-labelledby="k-profile-name">
        <div class="k-avatar" {...avatar}>
          <span class="k-avatar-flower" data-k-flower aria-hidden="true"><i></i></span>
          <span class="k-avatar-face" aria-hidden="true">{AVATAR_MONOGRAM}</span>
        </div>
        <div class="k-card">
          <div class="k-card-bar"><span class="k-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{profileIdentity.handle}</span></div>
          <p class="k-card-path" aria-hidden="true">laozhej.github.io{sitePath}</p>
          <p class="k-card-cmd" aria-hidden="true"><span>profile@arataki:~$</span> <b data-k-name data-names={JSON.stringify([profileIdentity.displayName, profileIdentity.alias])}>{profileIdentity.displayName}</b><span class="k-caret"></span></p>
          <h2 class="k-card-name" id="k-profile-name">{profileIdentity.displayName}<span> / {profileIdentity.alias}</span></h2>
          <p class="k-card-intro">{keepTails(profileIdentity.intro)}</p>
          <p class="k-card-links">
            {socialLinks.map((social) => <a href={social.href} target="_blank" rel="me noopener noreferrer" aria-label={t(`social.${social.key}`)}><Icon name={`tabler:brand-${social.key}`} size={16} aria-hidden="true" />{social.label}</a>)}
            <a class="k-card-about" href={href("/about/")}>{t("common.about")}<Icon name="tabler:arrow-right" size={15} aria-hidden="true" /></a>
          </p>
        </div>
      </section>
    </div>

    <section class="k-rail" id="k-contents" data-k-rail aria-labelledby="k-rail-title">
      <div class="k-rail-stage">
        <header class="k-rail-head">
          <div><p class="k-kicker">{t("article.contents")}</p><h2 id="k-rail-title">{keepTails(t("ema.home.railTitle"))}</h2></div>
          <div class="k-rail-status"><span data-k-rail-position aria-live="polite">01 / {pad(chapters.length)}</span><span class="k-rail-progress" data-k-rail-progress aria-hidden="true"></span></div>
        </header>
        <div class="k-track" data-k-track tabindex="0" aria-label={t("ema.about.bookmarks")}>
          {chapters.map((chapter, index) => (
            <a class="k-leaf" data-k-leaf data-plate={chapter.plate} data-active={index === 0 ? "true" : undefined} href={href(chapter.route)}>
              <span class="k-leaf-no">{pad(index + 1)} / {chapter.latin}</span>
              <div class="k-plate" aria-hidden="true">
                {chapter.plate === "journal" && (
                  <div class="k-plate-journal">
                    <strong>{pad(posts.length)}</strong><span>{t(posts.length === 1 ? "common.entriesOne" : "common.entries")}</span>
                    {posts.length > 0 ? <ul>{posts.map((post) => <li lang={post.data.locale}>{post.data.title}</li>)}</ul> : <p>{t("blog.empty")}</p>}
                  </div>
                )}
                {chapter.plate === "works" && project && (
                  <div class="k-plate-works">
                    <div class="k-plate-window"><span class="k-dots"><i></i><i></i><i></i></span><b>{shortTitle}</b><small>{project.type}</small></div>
                    <p><span class="k-plate-chip">{project.status}</span>{projectLine && <span class="k-plate-chip is-line">{projectLine}</span>}</p>
                    <ul>{project.details.map((detail) => <li>{detail}</li>)}</ul>
                  </div>
                )}
                {chapter.plate === "games" && (
                  <div class="k-plate-games">
                    <strong>{pad(gameShelf.length)}</strong><span>{t(gameShelf.length === 1 ? "common.gamesOne" : "common.games")}</span>
                    <ol>{favoriteGames.map((game, i) => <li><b>{pad(i + 1)}</b>{game.title}</li>)}</ol>
                  </div>
                )}
                {chapter.plate === "about" && (
                  <div class="k-plate-about">
                    <span class="k-plate-face">{AVATAR_MONOGRAM}</span>
                    <b>{profileIdentity.displayName}</b><small>{profileIdentity.alias}</small>
                    <ul>{profileTech.map((tool) => <li>{tool.name}</li>)}</ul>
                  </div>
                )}
              </div>
              <span class="k-stamp" aria-hidden="true"><i></i>{chapter.latin}</span>
              <div class="k-leaf-caption"><h3>{keepTails(chapter.title)}</h3><p>{keepTails(chapter.note)}</p></div>
              <Icon name="tabler:arrow-up-right" class="k-leaf-arrow" size={19} aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="k-signal" data-k-signal aria-labelledby="k-signal-title">
      <div class="k-signal-word"><h2 id="k-signal-title">{brandParts.map((part) => part === "." ? <i>.</i> : part)}</h2><small aria-hidden="true">notes / works / playroom / profile</small></div>
      <div class="k-clock" data-k-clock>
        <p data-k-date>{formatDate(new Date())}</p>
        <strong data-k-time>--:--:--</strong>
        <span>{t("ema.home.localTime")}</span>
      </div>
      {note && (
        <figure class="k-bubble" data-k-bubble>
          <figcaption data-k-bubble-title>{t("ema.notice.title").replace("{n}", noteNumber(note.number))}</figcaption>
          <p data-k-bubble-text lang={note.lang}>{note.text}</p>
          <button class="k-text-button" type="button" data-notice-open aria-haspopup="dialog" aria-controls="ema-notice" hidden>{t("ema.notice.open")}<Icon name="tabler:arrow-right" size={15} aria-hidden="true" /></button>
        </figure>
      )}
      <canvas class="k-rain" data-k-rain aria-hidden="true"></canvas>
      <ul class="k-tags" data-k-tags aria-label={t("ema.signal.tags")}>{tags.map((tag) => <li>{tag}</li>)}</ul>
      <button class="k-text-button k-rain-again" type="button" data-k-rain-again hidden><Icon name="tabler:sparkles" size={15} aria-hidden="true" />{t("ema.home.tagsAgain")}</button>
    </section>

    <section class="k-journal" id="journal" aria-labelledby="k-journal-title">
      <header class="k-journal-head">
        <div><p class="k-kicker">Journal</p><h2 id="k-journal-title">{t("home.latest")}</h2></div>
        {posts.length > 0 && <a href={href("/blog/")}>{t("common.allArticles")}<Icon name="tabler:arrow-right" size={17} aria-hidden="true" /></a>}
      </header>
      {posts.length > 0 ? (
        <div class="k-journal-grid">
          {posts.map((post) => {
            const date = post.data.updatedDate ?? post.data.pubDate;
            return <a class="k-entry" href={href(`/blog/${post.slug}/`)}><time datetime={date.toISOString()}>{formatDate(date)} · {categoryLabel[post.data.category]}</time><h3 lang={post.data.locale}>{keepTails(post.data.title)}</h3><p lang={post.data.locale}>{post.data.description}</p><Icon name="tabler:arrow-up-right" class="k-entry-arrow" size={18} aria-hidden="true" /></a>;
          })}
        </div>
      ) : (
        <div class="k-empty">
          <p>{keepTails(t("ema.empty.journalTitle"))}</p>
          <small>{keepTails(t("ema.empty.journalBody"))}</small>
          <span class="k-empty-acts">
            <a class="k-pill" href={href("/projects/")}>{t("ema.home.seeWork")}<Icon name="tabler:arrow-right" size={15} aria-hidden="true" /></a>
            {note && <button class="k-pill is-quiet" type="button" data-notice-open aria-haspopup="dialog" aria-controls="ema-notice" hidden><Icon name="tabler:note" size={15} aria-hidden="true" />{t("ema.notice.open")}</button>}
          </span>
        </div>
      )}
    </section>

    {note && (
      <dialog class="ema-notice" id="ema-notice" data-notice aria-labelledby="ema-notice-title" data-title={t("ema.notice.title")} data-notes={JSON.stringify(notes)}>
        <div class="notice-in">
          <div class="notice-h">
            <h2 id="ema-notice-title" data-notice-title>{t("ema.notice.title").replace("{n}", noteNumber(note.number))}</h2>
            <form method="dialog"><button class="x" type="submit" aria-label={t("ema.notice.close")} title={t("ema.notice.close")}><Icon name="tabler:x" size={18} aria-hidden="true" /></button></form>
          </div>
          <p class="notice-date" data-notice-date>{formatNoteDay(note.date, locale)}</p>
          <p class="notice-fallback" data-notice-fallback hidden={note.translated}>{t("ema.notice.fallback")}</p>
          <p class="notice-text" data-notice-text lang={note.lang}>{note.text}</p>
        </div>
      </dialog>
    )}
  </div>
</EmaLayout>
