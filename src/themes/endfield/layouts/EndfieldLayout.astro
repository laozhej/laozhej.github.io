---
import "@/core/styles/scale.css";
import "@/themes/blank/styles/theme.css";
import "@fontsource-variable/saira/wdth.css";
import "../styles/theme.css";
import { Icon } from "astro-icon/components";
import { site } from "@/lib/site";
import { getI18n, localizePath, locales, type Locale } from "@/core/i18n";
import { getThemePath, stripTheme } from "@/core/themes/registry";
import ThemePreference from "@/core/themes/ThemePreference.astro";
import ThemeSwitcher from "@/core/themes/ThemeSwitcher.astro";
import LanguagePreference from "@/core/i18n/LanguagePreference.astro";
import LanguageSwitcher from "@/core/i18n/LanguageSwitcher.astro";
import ColorModePreference from "@/core/preferences/ColorModePreference.astro";
import SiteIcons from "@/core/components/SiteIcons.astro";
import SiteAttribution from "@/core/components/SiteAttribution.astro";
import SocialLinks from "@/core/components/SocialLinks.astro";
import SiteNavigation from "@/core/navigation/SiteNavigation.astro";
import { pageTransition } from "@/core/navigation/animations.mjs";
const { locale, t } = getI18n(Astro.url.pathname);
const href = (path: string) => getThemePath("endfield", path, locale);
const path = stripTheme(Astro.url.pathname);
const { title: pageTitle = site.name, description = t("site.description"), isArticlePage = false, article, home = false } = Astro.props;
const brand = t("ema.brand");
const title = pageTitle.replaceAll(site.name, brand);
const canonical = Astro.site ? new URL(localizePath(Astro.url.pathname, locale), Astro.site) : undefined;
const navItems = site.nav.map((item, index) => ({
  ...item,
  label: t(`nav.${item.key}`),
  number: String(index + 1).padStart(2, "0"),
  active: item.href === "/" ? path === "/" : path.startsWith(item.href),
}));
---
<!doctype html>
<html lang={locale} data-theme="endfield" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <LanguagePreference /><ThemePreference /><SiteIcons />
    <ColorModePreference lightColor="#f4f4f2" darkColor="#191919" />
    <title>{title}</title><meta name="description" content={description} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content={isArticlePage ? "article" : "website"} />
    <meta property="og:locale" content={{ "zh-CN": "zh_CN", ja: "ja_JP", en: "en_US" }[locale]} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    {Astro.site && locales.map((language: Locale) => <link rel="alternate" hreflang={language} href={new URL(localizePath(Astro.url.pathname, language), Astro.site)} />)}
    {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
    <SiteNavigation />
  </head>
  <body data-blank data-endfield data-endfield-home={home ? "" : undefined}>
    <a class="blank-skip-link" href="#endfield-main">{t("a11y.skip")}</a>
    <header class="ef-header" data-site-header transition:name="site-header" transition:animate="none">
      <div class="ef-tri" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="ef-header-inner">
        <a class="ef-wordmark" href={href("/")} aria-label={`${brand} ${t("a11y.home")}`}><strong>{brand}</strong><small>EF / 03</small></a>
        <nav class="ef-nav" aria-label={t("a11y.navigation")}>
          {navItems.map((item) => <a href={href(item.href)} aria-current={item.active ? "page" : undefined}><span class="ef-nav-number" aria-hidden="true">{item.number}</span>{item.label}</a>)}
        </nav>
        <div class="ef-actions">
          <LanguageSwitcher />
          <button class="ef-button-icon" type="button" data-color-mode-toggle hidden aria-label={t("mode.label")} aria-pressed="false" title={t("mode.toDark")} data-label-dark={t("mode.toDark")} data-label-light={t("mode.toLight")}><span class="blank-mode-moon" aria-hidden="true"><Icon name="tabler:moon" size={18} /></span><span class="blank-mode-sun" aria-hidden="true"><Icon name="tabler:sun" size={18} /></span></button>
          <a class="ef-button-icon" href={href("/blog/#blank-search")} aria-label={t("a11y.search")} title={t("a11y.search")}><Icon name="tabler:search" size={18} /></a>
          <button class="ef-button-icon ef-motion-toggle" type="button" data-motion-toggle data-motion-pause={t("ema.motion.pause")} data-motion-resume={t("ema.motion.resume")} data-motion-reduced={t("ema.motion.reduced")} hidden aria-pressed="false" aria-label={t("ema.motion.pause")} title={t("ema.motion.pause")}><Icon name="tabler:player-pause" size={18} data-motion-pause-icon aria-hidden="true" /><Icon name="tabler:player-play" size={18} data-motion-play-icon aria-hidden="true" hidden /></button>
        </div>
      </div>
      {isArticlePage && <div class="blank-reading-track" aria-hidden="true"><span data-site-progress></span></div>}
    </header>
    <main id="endfield-main" class:list={[{ "ef-content blank-main": !home, "ef-home-main": home, "blank-main--article": isArticlePage }]} tabindex="-1" transition:name="site-content" transition:animate={pageTransition}><slot /></main>
    <footer class="ef-footer">
      <div class="ef-footer-top">
        <a class="ef-footer-brand" href={href("/")}>{brand}</a>
        <nav class="ef-footer-links" aria-label={t("a11y.navigation")}>
          <a href={href("/blog/")}>{t("footer.journal")}</a>
          <a href={href("/projects/")}>{t("footer.projects")}</a>
          <a href={href("/about/")}>{t("footer.about")}</a>
        </nav>
        <SocialLinks class="ef-footer-links" />
      </div>
      <div class="ef-footer-bottom"><SiteAttribution /><a href={href("/credits/")}>{t("footer.credits")}</a><a href="#endfield-main">{t("footer.top")} ↑</a></div>
    </footer>
    <ThemeSwitcher floating />
  </body>
</html>
